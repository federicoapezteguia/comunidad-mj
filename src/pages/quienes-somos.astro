---
import PaginaSimple from '../components/PaginaSimple.astro';
import { SITE } from '../config';
---
<PaginaSimple titulo="Quiénes somos" descripcion={`${SITE.nombre}: la señal de la red Comunidad FAN en Marcos Juárez, Córdoba. Noticias, música y radio en vivo.`}>
  <p><strong>{SITE.nombre}</strong> es la señal de la red Comunidad FAN en {SITE.ciudad}, provincia de {SITE.provincia}. Salimos al aire por FM {SITE.frecuencia} y en este sitio contamos lo que pasa en la ciudad, la región, la provincia y el país.</p>
  <p>Comunidad FAN es un medio multiplataforma nacido en Rosario que hoy llega a decenas de ciudades del país con radio, streaming y contenidos digitales. <a href={SITE.red} target="_blank" rel="noopener">Conocé la red</a>.</p>
  <h2>Contacto de la redacción</h2>
  <ul>
    <li>WhatsApp de la radio (saludos y mensajes): {SITE.whatsappVisible}</li>
    <li>Contacto comercial: {SITE.whatsappComercialVisible}</li>
  </ul>
  <h2>Nuestro equipo</h2>
  <p>[Completar con el equipo de la señal: nombre, rol y una línea de cada persona.]</p>
</PaginaSimple>
