---
import PaginaSimple from '../components/PaginaSimple.astro';
import { SITE } from '../config';
---
<PaginaSimple titulo="Quiénes somos" descripcion={`${SITE.nombre}: la señal de la red Comunidad FAN en Marcos Juárez, Córdoba. Noticias, música y radio en vivo.`}>
  <figure class="logo-qs">
    <img src={SITE.logoSenal.src} alt={SITE.logoSenal.alt} title={SITE.logoSenal.titulo} width={SITE.logoSenal.w} height={SITE.logoSenal.h} loading="lazy" />
  </figure>
  <p><strong>{SITE.nombre}</strong> es la señal de la red Comunidad FAN en {SITE.ciudad}, provincia de {SITE.provincia}. Salimos al aire por FM {SITE.frecuencia}.</p>
  <p>Comunidad FAN es un medio multiplataforma nacido en Rosario que hoy cuenta con <strong>más de 45 repetidoras en todo el país</strong>, con radio, streaming y contenidos digitales. <a href={SITE.red} target="_blank" rel="noopener">Conocé la red</a>.</p>
  <h2>Contacto de la redacción</h2>
  <ul>
    <li>WhatsApp de la radio (saludos y mensajes): {SITE.whatsappVisible}</li>
    <li>Contacto comercial: {SITE.whatsappComercialVisible}</li>
  </ul>
</PaginaSimple>
<style>
  .logo-qs { margin: 0 0 20px; }
  .logo-qs img { width: 200px; height: auto; }
</style>
