---
import PaginaSimple from '../components/PaginaSimple.astro';
import { SITE } from '../config';
const waRadio = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMensaje)}`;
const waComercial = `https://wa.me/${SITE.whatsappComercial}?text=${encodeURIComponent('Hola, quiero información para publicitar en Comunidad FAN Marcos Juárez')}`;
---
<PaginaSimple titulo="Contacto" descripcion={`Contactate con ${SITE.nombre}: WhatsApp para saludos y mensajes a la radio, y contacto comercial.`}>
  <h2>Mensajes y saludos para la radio</h2>
  <p>¿Querés mandar un saludo, pedir tu tema favorito, participar de los sorteos o contarnos algo? Escribinos por WhatsApp y salís al aire en la 99.9.</p>
  <p><a href={waRadio} class="boton boton-violeta" target="_blank" rel="noopener" style="text-decoration:none">WhatsApp de la radio · {SITE.whatsappVisible}</a></p>

  <h2>Contacto comercial</h2>
  <p>Para publicidad, banners, publinotas y menciones al aire.</p>
  <p><a href={waComercial} class="boton boton-violeta" target="_blank" rel="noopener" style="text-decoration:none">WhatsApp comercial · {SITE.whatsappComercialVisible}</a></p>
  <p>Más información en la página de <a href="/publicidad/">Publicidad</a>.</p>
</PaginaSimple>
