---
import Logo from './Logo.astro';
import Redes from './Redes.astro';
import Dial from './Dial.astro';
import { SECCIONES, SITE } from '../config';

const actual = Astro.url.pathname.split('/')[1] ?? '';
const menu = Object.entries(SECCIONES).filter(([, s]) => s.enMenu);
---
<header class="header">
  <div class="leyenda">
    <p class="wrap">La repetidora oficial de <strong>Comunidad FAN</strong> en Marcos Juárez<span class="frec"> · FM {SITE.frecuencia}</span></p>
  </div>
  <div class="wrap fila">
    <div class="marca-grupo">
      <a href="/" class="marca" aria-label="Comunidad FAN Marcos Juárez, ir al inicio"><Logo /></a>
      <a href="/" class="sello-fm" aria-label={`FM ${SITE.frecuencia} Marcos Juárez`} tabindex="-1">
        <span class="ondas" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="sello-txt">
          <span class="sello-num"><small>FM</small>{SITE.frecuencia}</span>
          <span class="sello-ciudad">Marcos Juárez</span>
        </span>
      </a>
    </div>

    <nav aria-label="Secciones" class="nav">
      <ul>
        {menu.map(([id, s]) => (
          <li><a href={`/${id}/`} aria-current={actual === id ? 'page' : undefined}>{s.nombre}</a></li>
        ))}
      </ul>
    </nav>

    <div class="acciones">
      <a href="/buscar/" class="icono-btn" aria-label="Buscar noticias">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
      </a>
      <button type="button" class="boton boton-amarillo en-vivo" data-radio-toggle aria-label="Escuchar o pausar la radio en vivo">
        <svg class="ic-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"></path></svg>
        <svg class="ic-pausa" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1h2.5v10H2.5zM7 1h2.5v10H7z" fill="currentColor"></path></svg>
        <span class="ic-carga" aria-hidden="true"></span>
        <span class="txt-play">En vivo</span><span class="txt-carga">Conectando</span><span class="txt-pausa">Pausar</span>
      </button>
      <div class="redes-header"><Redes /></div>
    </div>
  </div>
</header>

<style>
  .header { background: var(--fucsia); }
  .leyenda { background: var(--violeta-noche); }
  .leyenda p {
    margin: 0; padding-block: 7px; text-align: center;
    font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #fff;
  }
  .leyenda strong { color: var(--fucsia); font-weight: 900; }
  .leyenda .frec { color: var(--amarillo); }
  @media (max-width: 560px) {
    .leyenda p { font-size: 9.5px; letter-spacing: 0.03em; padding-block: 6px; white-space: nowrap; }
    .leyenda .frec { display: none; }
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding-block: 10px;
  }
  .marca { display: inline-flex; }
  .marca-grupo { display: flex; align-items: center; gap: 14px; }
  .sello-fm {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--amarillo); color: var(--violeta-noche);
    padding: 7px 14px 7px 10px; border-radius: 14px;
    box-shadow: 0 6px 16px -8px rgba(45, 0, 93, 0.7), inset 0 -3px 0 rgba(45, 0, 93, 0.15);
    line-height: 1; text-decoration: none;
  }
  .sello-fm:hover { color: var(--violeta-noche); }
  .sello-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
  .sello-num { font-size: 30px; font-weight: 900; letter-spacing: -0.02em; display: flex; align-items: flex-start; gap: 3px; }
  .sello-num small { font-size: 12px; font-weight: 900; margin-top: 3px; letter-spacing: 0.04em; }
  .sello-ciudad { font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }
  .ondas { position: relative; width: 26px; height: 26px; flex: none; }
  .ondas i {
    position: absolute; left: 50%; top: 50%; border-radius: 50%;
    border: 3px solid var(--violeta-noche); border-left-color: transparent; border-bottom-color: transparent;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .ondas i:nth-child(1) { width: 8px; height: 8px; background: var(--violeta-noche); border: 0; }
  .ondas i:nth-child(2) { width: 16px; height: 16px; }
  .ondas i:nth-child(3) { width: 26px; height: 26px; }
  @media (prefers-reduced-motion: no-preference) {
    .ondas i:nth-child(2) { animation: onda 1.8s ease-in-out infinite; }
    .ondas i:nth-child(3) { animation: onda 1.8s ease-in-out 0.3s infinite; }
    @keyframes onda { 0%, 100% { opacity: 0.25; } 40% { opacity: 1; } }
  }
  @media (max-width: 560px) {
    .fila { flex-wrap: wrap; padding-block: 6px 2px; gap: 2px 10px; }
    .nav ul { gap: 4px 18px; padding: 0; }
    .nav a { font-size: 13px; padding: 6px 0 4px; }
    .icono-btn { width: 38px; height: 38px; }
    .acciones { gap: 4px; }
    .en-vivo { width: 40px; height: 40px; padding: 0; justify-content: center; border-radius: 50%; }
    .en-vivo .txt-play, .en-vivo .txt-carga, .en-vivo .txt-pausa { display: none !important; }
    .marca-grupo { gap: 10px; }
    .sello-fm { padding: 5px 9px 5px 7px; gap: 6px; border-radius: 10px; }
    .sello-num { font-size: 20px; }
    .sello-num small { font-size: 10px; margin-top: 2px; }
    .sello-ciudad { font-size: 8px; }
    .ondas { width: 20px; height: 20px; }
    .ondas i:nth-child(3) { width: 20px; height: 20px; }
    .ondas i:nth-child(2) { width: 12px; height: 12px; }
    .ondas i:nth-child(1) { width: 6px; height: 6px; }
  }
  .nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; }
  .nav::-webkit-scrollbar { display: none; }
  .nav ul { display: flex; gap: 6px 22px; list-style: none; margin: 0; padding: 4px 0; white-space: nowrap; }
  .nav a {
    color: var(--violeta);
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    padding: 8px 0 5px;
    border-bottom: 3px solid transparent;
    display: inline-block;
  }
  .nav a:hover { border-bottom-color: var(--violeta); color: var(--violeta); }
  .nav a[aria-current='page'] { border-bottom-color: var(--violeta); }
  .acciones { display: flex; align-items: center; gap: 8px; }
  .icono-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; color: var(--violeta);
  }
  .icono-btn:hover { background: rgba(255, 255, 255, 0.3); color: var(--violeta); }
  .redes-header { display: none; }
  @media (min-width: 1180px) {
    .nav { order: 0; width: auto; flex: 1 1 auto; display: flex; justify-content: center; }
    .nav ul { gap: 6px 18px; }
    .nav a { font-size: 14px; }
    .fila { flex-wrap: nowrap; }
  }
</style>
