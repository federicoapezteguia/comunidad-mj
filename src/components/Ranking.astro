---
import { RANKING } from '../data/ranking';
---
<div class="ranking">
  <svg class="vinilo" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="98" fill="#1a0033"></circle>
    <g fill="none" stroke="#3d1670" stroke-width="1.2">
      <circle cx="100" cy="100" r="88"></circle><circle cx="100" cy="100" r="80"></circle><circle cx="100" cy="100" r="72"></circle>
      <circle cx="100" cy="100" r="64"></circle><circle cx="100" cy="100" r="56"></circle><circle cx="100" cy="100" r="48"></circle>
    </g>
    <path d="M100 6 A94 94 0 0 1 180 52" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="5" stroke-linecap="round"></path>
    <circle cx="100" cy="100" r="34" fill="var(--fucsia)"></circle>
    <text x="100" y="98" text-anchor="middle" font-size="13" font-weight="900" fill="#2d005d" font-family="Montserrat, sans-serif">FM 99.9</text>
    <text x="100" y="112" text-anchor="middle" font-size="7" font-weight="800" fill="#2d005d" font-family="Montserrat, sans-serif">COMUNIDAD FAN</text>
    <circle cx="100" cy="100" r="4" fill="#fff"></circle>
  </svg>
  <h2 class="sec-h chico">Ranking FAN</h2>
  <ol>
    {RANKING.map((r, i) => (
      <li>
        <span class="pos" aria-hidden="true">{i + 1}</span>
        <span class="disco" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
        </span>
        <span class="info"><span class="tema">{r.tema}</span><span class="artista">{r.artista}</span></span>
      </li>
    ))}
  </ol>
</div>
<style>
  .ranking { width: 100%; position: relative; isolation: isolate; overflow: hidden; padding-bottom: 8px; }
  .vinilo {
    position: absolute; z-index: -1; right: -80px; bottom: -70px;
    width: 240px; height: 240px; opacity: 0.16; pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vinilo { animation: girar-vinilo 14s linear infinite; }
    :global(html[data-radio='sonando']) .vinilo { animation-duration: 3.5s; opacity: 0.22; }
    @keyframes girar-vinilo { to { transform: rotate(360deg); } }
  }
  .sec-h.chico { font-size: 18px; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  li { display: flex; gap: 12px; align-items: center; }
  .pos { font-size: 26px; font-weight: 900; color: var(--fucsia); width: 20px; text-align: center; }
  .disco { width: 52px; height: 52px; flex: none; border-radius: var(--radio); background: var(--violeta); color: var(--amarillo); display: flex; align-items: center; justify-content: center; }
  .info { display: flex; flex-direction: column; min-width: 0; }
  .tema { font-size: 14px; font-weight: 800; color: var(--violeta); }
  .artista { font-size: 13px; color: var(--gris); }
</style>
