---
interface Props { url: string; titulo: string }
const { url, titulo } = Astro.props;
const t = encodeURIComponent(titulo);
const u = encodeURIComponent(url);
---
<div class="compartir" aria-label="Compartir esta nota">
  <a class="c wa" href={`https://wa.me/?text=${t}%20${u}`} target="_blank" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 20l1.5-4A8 8 0 1 1 8 18.5z"></path></svg>
    WhatsApp
  </a>
  <a class="c" href={`https://www.facebook.com/sharer/sharer.php?u=${u}`} target="_blank" rel="noopener">Facebook</a>
  <a class="c" href={`https://x.com/intent/post?text=${t}&url=${u}`} target="_blank" rel="noopener">X</a>
  <button class="c" type="button" data-copiar={url}>Copiar enlace</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copiar ?? location.href);
        const t = b.textContent;
        b.textContent = '¡Copiado!';
        setTimeout(() => (b.textContent = t), 1800);
      } catch {}
    });
  });
</script>
<style>
  .compartir { display: flex; flex-wrap: wrap; gap: 8px; }
  .c {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px;
    border-radius: 500px; font-size: 14px; font-weight: 700; font-family: inherit;
    background: var(--lila-claro); color: var(--violeta); border: 0; cursor: pointer;
  }
  .c:hover { background: var(--lila); color: var(--violeta); }
  .wa { background: #1f7a3a; color: #fff; }
  .wa:hover { background: #18652f; color: #fff; }
</style>
