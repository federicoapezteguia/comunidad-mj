---
// El tiempo en Marcos Juárez.
// Datos en vivo de Open-Meteo (gratuito, sin clave). El botón lleva al
// pronóstico oficial del Servicio Meteorológico Nacional.
const SMN = 'https://www.smn.gob.ar/pronostico/?loc=4478';
const LAT = -32.6978;
const LON = -62.1067;
---
<section class="clima" aria-labelledby="clima-h" data-clima data-lat={LAT} data-lon={LON}>
  <div class="cab">
    <h2 id="clima-h">El tiempo en Marcos Juárez</h2>
  </div>
  <div class="ahora">
    <span class="icono" data-icono aria-hidden="true"></span>
    <div>
      <div class="temp" data-temp>--°</div>
      <div class="estado" data-estado>Cargando…</div>
    </div>
    <div class="extremos" data-extremos></div>
  </div>
  <ul class="dias" data-dias></ul>
  <a href={SMN} target="_blank" rel="noopener" class="smn">Pronóstico extendido en el SMN ›</a>
  <p class="fuente">Datos: Open-Meteo · Pronóstico oficial: Servicio Meteorológico Nacional</p>
</section>

<script>
  const ICONOS: Record<string, string> = {
    sol: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
    luna: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>',
    nubes: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 18h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18z"/></svg>',
    parcial: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v1.5M3.5 8H2M4.6 4.6l1 1M13.4 4.6l-1 1"/><path d="M5.2 11a4 4 0 0 1 7.3-3"/><path d="M9 20h8a3.5 3.5 0 0 0 .4-7 5 5 0 0 0-9.5 1.2A3 3 0 0 0 9 20z"/></svg>',
    lluvia: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 15h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 6.5 4.3 4.3 0 0 0 7 15z"/><path d="M8 18l-1 3M12 18l-1 3M16 18l-1 3"/></svg>',
    tormenta: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 6.5 4.3 4.3 0 0 0 7 15z"/><path d="M12.5 15l-2 3.5h3l-2 3.5"/></svg>',
    niebla: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9h16M3 13h18M5 17h14"/></svg>',
    nieve: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/></svg>',
  };
  function describir(code: number, dia = true): [string, string] {
    if (code === 0) return [dia ? 'sol' : 'luna', 'Despejado'];
    if (code <= 2) return ['parcial', code === 1 ? 'Mayormente despejado' : 'Parcialmente nublado'];
    if (code === 3) return ['nubes', 'Nublado'];
    if (code <= 48) return ['niebla', 'Niebla'];
    if (code <= 57) return ['lluvia', 'Llovizna'];
    if (code <= 67) return ['lluvia', 'Lluvia'];
    if (code <= 77) return ['nieve', 'Nieve'];
    if (code <= 82) return ['lluvia', 'Chaparrones'];
    if (code <= 86) return ['nieve', 'Nevadas'];
    return ['tormenta', 'Tormentas'];
  }
  const DIAS = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

  document.querySelectorAll<HTMLElement>('[data-clima]').forEach(async (el) => {
    const q = (s: string) => el.querySelector<HTMLElement>(s)!;
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${el.dataset.lat}&longitude=${el.dataset.lon}&current=temperature_2m,weather_code,is_day,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=America%2FArgentina%2FCordoba&forecast_days=4`;
      const r = await fetch(url);
      if (!r.ok) throw new Error();
      const d = await r.json();
      const [ico, txt] = describir(d.current.weather_code, d.current.is_day === 1);
      q('[data-icono]').innerHTML = ICONOS[ico];
      q('[data-temp]').textContent = `${Math.round(d.current.temperature_2m)}°`;
      q('[data-estado]').textContent = `${txt} · Viento ${Math.round(d.current.wind_speed_10m)} km/h`;
      q('[data-extremos]').innerHTML = `<span>Máx <b>${Math.round(d.daily.temperature_2m_max[0])}°</b></span><span>Mín <b>${Math.round(d.daily.temperature_2m_min[0])}°</b></span>`;
      q('[data-dias]').innerHTML = [1, 2, 3]
        .map((i) => {
          const f = new Date(d.daily.time[i] + 'T12:00:00');
          const [di, dt] = describir(d.daily.weather_code[i]);
          const lluvia = d.daily.precipitation_probability_max?.[i];
          return `<li><span class="dn">${DIAS[f.getDay()]}</span><span class="di" title="${dt}">${ICONOS[di]}</span><span class="dt">${Math.round(d.daily.temperature_2m_max[i])}° / ${Math.round(d.daily.temperature_2m_min[i])}°</span>${lluvia != null ? `<span class="dl">${lluvia}% lluvia</span>` : ''}</li>`;
        })
        .join('');
    } catch {
      q('[data-estado]').textContent = 'Mirá el pronóstico en el SMN';
      q('[data-temp]').textContent = '';
    }
  });
</script>

<style>
  .clima { width: 100%; background: var(--violeta); color: #fff; border-radius: var(--radio); padding: 18px 18px 14px; }
  h2 { margin: 0; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--amarillo); }
  .ahora { display: flex; align-items: center; gap: 12px; margin: 14px 0 12px; }
  .icono { width: 52px; height: 52px; flex: none; color: var(--amarillo); }
  .icono :global(svg) { width: 100%; height: 100%; }
  .temp { font-size: 40px; font-weight: 900; line-height: 1; }
  .estado { font-size: 13px; font-weight: 600; color: #e6d9f5; margin-top: 4px; }
  .extremos { margin-left: auto; display: flex; flex-direction: column; gap: 2px; font-size: 13px; color: #e6d9f5; text-align: right; }
  .extremos :global(b) { color: #fff; }
  .dias { list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid rgba(255, 255, 255, 0.18); display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .dias :global(li) { display: flex; flex-direction: column; align-items: center; gap: 3px; text-align: center; }
  .dias :global(.dn) { font-size: 12px; font-weight: 800; text-transform: uppercase; }
  .dias :global(.di) { width: 26px; height: 26px; color: var(--amarillo); }
  .dias :global(.di svg) { width: 100%; height: 100%; }
  .dias :global(.dt) { font-size: 13px; font-weight: 700; }
  .dias :global(.dl) { font-size: 11px; color: #d2c1ea; }
  .smn {
    display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 14px;
    background: var(--amarillo); color: #000; border-radius: 500px; font-weight: 800; font-size: 13px; text-transform: uppercase;
  }
  .smn:hover { color: #000; filter: brightness(1.05); }
  .fuente { margin: 8px 0 0; font-size: 10.5px; color: #c9b6e3; text-align: center; }
</style>
