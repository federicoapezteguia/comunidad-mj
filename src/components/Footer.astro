---
import Logo from './Logo.astro';
import Redes from './Redes.astro';
import { SITE, SECCIONES } from '../config';
const anio = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap fila">
    <div class="datos">
      <Logo tam="chico" />
      <p>
        FM {SITE.frecuencia} · {SITE.ciudad}, {SITE.provincia}<br />
        Saludos al aire: {SITE.whatsappVisible}<br />
        Comercial: {SITE.whatsappComercialVisible}
      </p>
      <Redes />
    </div>
    <nav aria-label="Secciones del sitio">
      <h2>Secciones</h2>
      <ul>
        {Object.entries(SECCIONES).map(([id, s]) => <li><a href={`/${id}/`}>{s.nombre}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Institucional">
      <h2>El medio</h2>
      <ul>
        <li><a href="/quienes-somos/">Quiénes somos</a></li>
        <li><a href="/publicidad/">Publicidad</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href={SITE.reproductor} target="_blank" rel="noopener">Escuchar en vivo</a></li>
        <li><a href={SITE.red} target="_blank" rel="noopener">Red Comunidad FAN</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">© {anio} {SITE.nombre} · Parte de la red Comunidad FAN</div>
</footer>

<style>
  .footer { background: var(--fucsia); color: var(--violeta); padding: 40px 0 96px; margin-top: 64px; }
  .fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px; }
  .datos { max-width: 340px; display: flex; flex-direction: column; gap: 12px; }
  .datos p { margin: 0; font-size: 14px; font-weight: 600; }
  h2 { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  ul a { font-size: 14px; font-weight: 700; display: inline-block; padding: 6px 0; }
  ul a:hover { color: var(--blanco); }
  .legal { margin-top: 28px; font-size: 12px; font-weight: 600; }
</style>
