---
import Redes from './Redes.astro';
import { SITE, SECCIONES } from '../config';
const anio = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="sello">
      <img src="/favicon.svg" alt="" width="56" height="56" class="mano" aria-hidden="true" />
      <p><span class="s1">La repetidora oficial de</span><span class="s2">Comunidad FAN <em>en Marcos Juárez</em></span></p>
    </div>
  </div>
  <div class="wrap fila">
    <div class="datos">
      <img src={SITE.logoSenal.src} alt={SITE.logoSenal.alt} title={SITE.logoSenal.titulo} width={SITE.logoSenal.w} height={SITE.logoSenal.h} loading="lazy" class="logo-senal" />
      <p>
        FM {SITE.frecuencia} · {SITE.ciudad}, {SITE.provincia}<br />
        Saludos al aire: {SITE.whatsappVisible}<br />
        Comercial: {SITE.whatsappComercialVisible}
      </p>
      <Redes />
    </div>
    <nav aria-label="Secciones del sitio">
      <h2>Secciones</h2>
      <ul>
        {Object.entries(SECCIONES).map(([id, s]) => <li><a href={`/${id}/`}>{s.nombre}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Institucional">
      <h2>El medio</h2>
      <ul>
        <li><a href="/quienes-somos/">Quiénes somos</a></li>
        <li><a href="/publicidad/">Publicidad</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href="/en-vivo/">Escuchar en vivo</a></li>
        <li><a href={SITE.youtubeVivo} target="_blank" rel="noopener">Mirar en YouTube</a></li>
        <li><a href={SITE.red} target="_blank" rel="noopener">Red Comunidad FAN</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap pie">
    <div class="legal">© {anio} {SITE.nombre} · La repetidora oficial de Comunidad FAN en Marcos Juárez</div>
    <a href="https://agenciarok.com.ar/" target="_blank" rel="noopener" class="rok">
      <span>Desarrollado por</span>
      <img src="https://agenciarok.com.ar/assets/img/logo-rok-agencia-diseno-web.png" alt="ROK Agencia de diseño web" title="ROK Agencia – Diseño web" height="40" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  .footer { background: var(--fucsia); color: var(--violeta); padding: 40px 0 96px; margin-top: 64px; }
  .sello {
    display: flex; align-items: center; justify-content: center; gap: 16px;
    background: var(--violeta); border-radius: 16px; padding: 18px 24px; margin-bottom: 36px; text-align: left;
  }
  .mano { width: 56px; height: 56px; flex: none; }
  .sello p { margin: 0; display: flex; flex-direction: column; line-height: 1.15; }
  .s1 { font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; }
  .s2 { font-size: clamp(20px, 3.2vw, 30px); font-weight: 900; color: var(--fucsia); }
  .s2 em { font-style: normal; color: #fff; }
  @media (max-width: 480px) { .sello { padding: 16px; gap: 12px; } .mano { width: 44px; height: 44px; } }
  .fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px; }
  .datos { max-width: 340px; display: flex; flex-direction: column; gap: 12px; }
  .logo-senal { width: 130px; height: auto; }
  .datos p { margin: 0; font-size: 14px; font-weight: 600; }
  h2 { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  ul a { font-size: 14px; font-weight: 700; display: inline-block; padding: 6px 0; }
  ul a:hover { color: var(--blanco); }
  .pie { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; }
  .legal { font-size: 12px; font-weight: 600; }
  .rok { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; color: var(--violeta); }
  .rok img { height: 40px; width: auto; }
  .rok:hover { color: var(--blanco); }
</style>
