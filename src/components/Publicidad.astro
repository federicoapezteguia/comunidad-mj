---
import { BANNERS, MEDIDAS, type EspacioId } from '../data/publicidad';
interface Props { espacio: EspacioId; class?: string; orden?: number }
const { espacio, class: clase, orden = 0 } = Astro.props;
const hoy = new Date().toISOString().slice(0, 10);
const vigentes = BANNERS[espacio].filter((b) => (!b.desde || b.desde <= hoy) && (!b.hasta || b.hasta >= hoy));
// Si un espacio tiene varios anunciantes, cada ubicación (orden) muestra uno distinto
const b = vigentes.length ? vigentes[orden % vigentes.length] : undefined;
const m = MEDIDAS[espacio];
const ratio = b?.w && b?.h ? `${b.w} / ${b.h}` : `${m.w} / ${m.h}`;
const ratioMovil = b?.w && b?.h ? ratio : m.wMovil ? `${m.wMovil} / ${m.hMovil}` : ratio;
---
<aside class:list={['pub', espacio, clase]} aria-label="Publicidad" style={`--w:${m.w}px; --ratio:${ratio}; --ratio-movil:${ratioMovil}`}>
  {b ? (
    b.enlace ? (
      <a href={b.enlace} target="_blank" rel="sponsored noopener">
        <picture>
          {b.imagenMovil && <source media="(max-width: 720px)" srcset={b.imagenMovil} />}
          <img src={b.imagen} alt={`Publicidad: ${b.anunciante}`} width={b.w ?? m.w} height={b.h ?? m.h} loading="lazy" />
        </picture>
      </a>
    ) : (
      <picture>
        {b.imagenMovil && <source media="(max-width: 720px)" srcset={b.imagenMovil} />}
        <img src={b.imagen} alt={`Publicidad: ${b.anunciante}`} width={b.w ?? m.w} height={b.h ?? m.h} loading="lazy" />
      </picture>
    )
  ) : (
    <a href="/publicidad/" class="propia">
      <span class="t1">Tu marca acá</span>
      <span class="t2">Publicitá en Comunidad FAN Marcos Juárez</span>
    </a>
  )}
</aside>

<style>
  .pub { width: 100%; max-width: var(--w); margin-inline: auto; aspect-ratio: var(--ratio); }
  @media (max-width: 720px) { .pub { aspect-ratio: var(--ratio-movil); } }
  .pub a, .pub picture, .pub img { display: block; width: 100%; height: 100%; }
  .pub img { object-fit: cover; border-radius: var(--radio); }
  .propia {
    display: flex !important; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
    background: var(--lila-claro); border: 2px dashed #b9a3d6; border-radius: var(--radio);
    text-align: center; padding: 12px;
  }
  .t1 { font-size: 15px; font-weight: 800; color: var(--violeta); text-transform: uppercase; letter-spacing: 0.04em; }
  .t2 { font-size: 12px; font-weight: 600; color: var(--gris); }
  .horizontal img { box-shadow: 0 0 0 1px #dfe7e7; }
  /* Campañas: el blanco de la imagen se funde con el fondo #fafafa del sitio */
  .campanas picture { background: #fafafa; border-radius: var(--radio); }
  .campanas img { mix-blend-mode: multiply; }
  /* Campañas en 3D: tarjeta elevada con sombra en capas y leve inclinación que sigue al mouse */
  .campanas { perspective: 1200px; }
  .campanas a {
    border-radius: var(--radio); transform-style: preserve-3d;
    box-shadow: 0 1px 2px rgba(45, 0, 93, 0.08), 0 6px 14px -6px rgba(45, 0, 93, 0.18), 0 26px 50px -22px rgba(255, 0, 255, 0.38);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateZ(0);
    transition: transform 0.25s ease-out, box-shadow 0.3s ease;
    position: relative;
  }
  .campanas a::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(circle at var(--bx, 50%) var(--by, 0%), rgba(255, 255, 255, 0.55), transparent 55%);
    opacity: 0; transition: opacity 0.3s ease;
  }
  .campanas a:hover {
    box-shadow: 0 2px 4px rgba(45, 0, 93, 0.1), 0 12px 24px -10px rgba(45, 0, 93, 0.25), 0 40px 70px -26px rgba(255, 0, 255, 0.5);
  }
  .campanas a:hover::after { opacity: 0.6; }
  .campanas .propia { background: var(--violeta); border: 0; border-radius: 0; }
  .campanas .t1 { color: var(--amarillo); font-size: clamp(18px, 3vw, 34px); }
  .campanas .t2 { color: #fff; font-size: clamp(12px, 1.4vw, 16px); }
</style>

<script>
  // Inclinación 3D de la campaña según la posición del mouse (solo con mouse y sin "reducir movimiento")
  function inclinar() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover)').matches) return;
    document.querySelectorAll<HTMLElement>('.pub.campanas a').forEach((a) => {
      if (a.dataset.tilt) return;
      a.dataset.tilt = '1';
      a.addEventListener('mousemove', (e) => {
        const r = a.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        a.style.setProperty('--ry', ((x - 0.5) * 6).toFixed(2) + 'deg');
        a.style.setProperty('--rx', ((0.5 - y) * 8).toFixed(2) + 'deg');
        a.style.setProperty('--bx', (x * 100).toFixed(0) + '%');
        a.style.setProperty('--by', (y * 100).toFixed(0) + '%');
      });
      a.addEventListener('mouseleave', () => { a.style.setProperty('--rx', '0deg'); a.style.setProperty('--ry', '0deg'); });
    });
  }
  document.addEventListener('astro:page-load', inclinar);
</script>
