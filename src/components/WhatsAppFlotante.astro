---
import { SITE } from '../config';
import IconoWhatsApp from './IconoWhatsApp.astro';
const url = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMensaje)}`;
---
{SITE.whatsapp && (
  <a href={url} target="_blank" rel="noopener" class="wa-flotante" aria-label="Mandá tu saludo al aire por WhatsApp">
    <span class="icono" aria-hidden="true"><IconoWhatsApp tam={28} /></span>
    <span class="txt">
      <span class="t1">¡Mandá tu saludo al aire!</span>
      <span class="t2">Escribinos por WhatsApp</span>
    </span>
  </a>
)}
<style>
  .wa-flotante {
    position: fixed; right: 16px; bottom: 80px; z-index: 60;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 18px 6px 6px; border-radius: 500px;
    background: #1f7a3a; color: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .wa-flotante:hover { background: #18652f; color: #fff; transform: translateY(-2px); }
  .icono { width: 48px; height: 48px; border-radius: 50%; background: #25d366; color: #fff; display: flex; align-items: center; justify-content: center; flex: none; }
  .txt { display: flex; flex-direction: column; line-height: 1.2; }
  .t1 { font-size: 14px; font-weight: 800; }
  .t2 { font-size: 12px; font-weight: 600; opacity: 0.9; }
  @media (max-width: 560px) {
    .wa-flotante { right: 12px; bottom: 76px; padding: 4px 14px 4px 4px; gap: 8px; }
    .icono { width: 44px; height: 44px; }
    .t1 { font-size: 13px; }
    .t2 { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .icono { animation: pulso 2.4s ease-out 1.5s 3; }
    @keyframes pulso { 0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6); } 100% { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); } }
  }
</style>
