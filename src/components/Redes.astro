---
import { SITE } from '../config';
interface Props { color?: string; tam?: number }
const { color = 'var(--violeta)', tam = 22 } = Astro.props;
const r = SITE.redes;
const wa = SITE.whatsapp ? `https://wa.me/${SITE.whatsapp}` : '';
const items = [
  { url: r.instagram, nombre: 'Instagram', d: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5h.01' },
  { url: r.facebook, nombre: 'Facebook', d: 'M15 3h-3a4 4 0 0 0-4 4v3H6v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z' },
  { url: r.youtube, nombre: 'YouTube', d: 'M6 5h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4zm4 4v6l5-3z' },
  { url: r.tiktok, nombre: 'TikTok', d: 'M14 3v11a3.5 3.5 0 1 1-3-3.46M14 3c.5 2.5 2.3 4 5 4' },
  { url: r.x, nombre: 'X', d: 'M4 4l16 16M20 4L4 20' },
  { url: wa, nombre: 'WhatsApp', d: 'M4 20l1.5-4A8 8 0 1 1 8 18.5z' },
].filter((i) => i.url);
---
{items.length > 0 && (
  <ul class="redes" aria-label="Redes sociales">
    {items.map((i) => (
      <li>
        <a href={i.url} aria-label={i.nombre} target="_blank" rel="noopener">
          <svg width={tam} height={tam} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={i.d} /></svg>
        </a>
      </li>
    ))}
  </ul>
)}
<style>
  .redes { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .redes a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; }
  .redes a:hover { background: rgba(255, 255, 255, 0.25); }
</style>
