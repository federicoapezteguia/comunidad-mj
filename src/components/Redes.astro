---
import { SITE } from '../config';
interface Props { color?: string; tam?: number }
const { color = 'var(--violeta)', tam = 22 } = Astro.props;
const r = SITE.redes;
const wa = SITE.whatsapp ? `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMensaje)}` : '';
const items = [
  { url: r.instagram, nombre: 'Instagram', d: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5h.01' },
  { url: r.facebook, nombre: 'Facebook', d: 'M15 3h-3a4 4 0 0 0-4 4v3H6v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z' },
  { url: r.youtube, nombre: 'YouTube', d: 'M6 5h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4zm4 4v6l5-3z' },
  { url: r.tiktok, nombre: 'TikTok', d: 'M14 3v11a3.5 3.5 0 1 1-3-3.46M14 3c.5 2.5 2.3 4 5 4' },
  { url: r.x, nombre: 'X', d: 'M4 4l16 16M20 4L4 20' },
  { url: wa, nombre: 'WhatsApp', d: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z', relleno: true },
].filter((i) => i.url);
---
{items.length > 0 && (
  <ul class="redes" aria-label="Redes sociales">
    {items.map((i) => (
      <li>
        <a href={i.url} aria-label={i.nombre} target="_blank" rel="noopener">
          {i.relleno ? <svg width={tam} height={tam} viewBox="0 0 24 24" fill={color} aria-hidden="true"><path d={i.d} /></svg> : <svg width={tam} height={tam} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={i.d} /></svg>}
        </a>
      </li>
    ))}
  </ul>
)}
<style>
  .redes { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .redes a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; }
  .redes a:hover { background: rgba(255, 255, 255, 0.25); }
</style>
