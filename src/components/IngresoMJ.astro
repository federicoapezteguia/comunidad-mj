---
// Símbolo del ingreso a Marcos Juárez (arco con el nombre de la ciudad y las letras MJ),
// dibujado en línea con brillo tipo neón, como se ve de noche.
---
<div class="ingreso-mj" aria-hidden="true">
  <svg viewBox="0 0 640 230" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <filter id="neon-mj" x="-20%" y="-40%" width="140%" height="180%">
        <feGaussianBlur stdDeviation="4" result="b1"></feGaussianBlur>
        <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="b2"></feGaussianBlur>
        <feMerge><feMergeNode in="b2"></feMergeNode><feMergeNode in="b1"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
      </filter>
      <path id="arco-mj" d="M44 204 C128 44 352 36 424 184"></path>
    </defs>
    <!-- Suelo -->
    <path d="M10 214 H630" stroke="var(--violeta)" stroke-width="2" opacity="0.35"></path>
    <!-- Estructura de cemento: el arco baja y nace en la base de la M -->
    <path d="M14 212 C110 22 372 14 438 196 Q442 210 452 212 L436 212 C362 52 132 60 46 212 Z" fill="var(--violeta)" opacity="0.08" stroke="var(--violeta)" stroke-width="2.5" stroke-opacity="0.45"></path>
    <path d="M446 112 V206 M446 112 L486 168 L526 112 V206 M552 112 H600 M584 112 V180 Q584 206 560 206 Q544 206 538 194" stroke="var(--violeta)" stroke-width="26" opacity="0.1"></path>
    <!-- Neón: una sola línea continua, del arco a la M y de la M a la J -->
    <g class="neon" filter="url(#neon-mj)" stroke="var(--fucsia)" stroke-width="3.5">
      <path d="M30 210 C120 40 352 32 428 186 Q436 206 446 206 V114 L486 170 L526 114 V206"></path>
      <path d="M552 114 H600 M584 114 V180 Q584 204 560 204 Q546 204 540 194"></path>
    </g>
    <text class="nombre" font-size="17" font-weight="900" letter-spacing="3" fill="var(--violeta)" font-family="'Montserrat Variable', Montserrat, sans-serif">
      <textPath href="#arco-mj" startOffset="14%">MARCOS JUÁREZ</textPath>
    </text>
  </svg>
</div>
<style>
  .ingreso-mj { width: 100%; max-width: 860px; margin: 0 auto; opacity: 0.38; pointer-events: none; }
  .ingreso-mj svg { width: 100%; height: auto; display: block; overflow: visible; }
  .nombre { opacity: 0.55; }
  @media (prefers-reduced-motion: no-preference) {
    .neon { animation: neon-mj 5s ease-in-out infinite; }
    @keyframes neon-mj { 0%, 100% { opacity: 1; } 45% { opacity: 0.85; } 48% { opacity: 0.35; } 50% { opacity: 0.95; } 52% { opacity: 0.5; } 55% { opacity: 1; } }
  }
</style>
