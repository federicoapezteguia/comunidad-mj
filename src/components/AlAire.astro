---
import { PROGRAMACION, RELLENO } from '../data/programacion';
import { SITE } from '../config';
---
<section class="al-aire-box" aria-labelledby="h-al-aire" data-al-aire>
  <i class="mano" aria-hidden="true"></i>
  <h2 id="h-al-aire" class="cab">
    <span class="luz" aria-hidden="true"><i></i>Al aire</span>
    <span class="frec">FM {SITE.frecuencia}</span>
  </h2>

  <p class="ahora-lbl">Ahora</p>
  <p class="prog" data-prog>{RELLENO.nombre}</p>
  <p class="cond" data-cond>{RELLENO.conductores}</p>
  <div class="tiempo" data-tiempo hidden>
    <span class="barra"><span data-avance></span></span>
    <span class="horas" data-horas></span>
  </div>

  <div class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>

  <button type="button" class="escuchar" data-radio-toggle aria-label="Escuchar o pausar la radio en vivo">
    <svg class="ic-play" width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"></path></svg>
    <svg class="ic-pausa" width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1h2.5v10H2.5zM7 1h2.5v10H7z" fill="currentColor"></path></svg>
    <span class="t-play">Escuchar en vivo</span><span class="t-pausa">Pausar</span>
  </button>

  <div class="despues" data-despues hidden>
    <span class="d-lbl">Después</span>
    <span class="d-prog" data-dprog></span>
  </div>
</section>

<script is:inline define:vars={{ grilla: PROGRAMACION, relleno: RELLENO }}>
  (() => {
    const min = (t) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
    const ahoraAR = () => {
      const p = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: 'America/Argentina/Cordoba', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false })
        .formatToParts(new Date()).map((x) => [x.type, x.value]));
      const dias = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
      return { dia: dias[p.weekday], m: (Number(p.hour) % 24) * 60 + Number(p.minute) };
    };
    function pintar() {
      const box = document.querySelector('[data-al-aire]');
      if (!box) return;
      const { dia, m } = ahoraAR();
      const actual = grilla.find((p) => p.dias.includes(dia) && m >= min(p.desde) && m < min(p.hasta));
      const $ = (s) => box.querySelector(s);
      $('[data-prog]').textContent = actual ? actual.nombre : relleno.nombre;
      $('[data-cond]').textContent = actual ? (actual.conductores || '') : relleno.conductores;
      const t = $('[data-tiempo]');
      if (actual) {
        const d = min(actual.desde), h = min(actual.hasta);
        $('[data-avance]').style.width = Math.round(((m - d) / (h - d)) * 100) + '%';
        $('[data-horas]').textContent = actual.desde + ' a ' + (actual.hasta === '24:00' ? '00:00' : actual.hasta);
        t.hidden = false;
      } else t.hidden = true;
      // Próximo programa: hoy más tarde, o el primero de los días siguientes
      let prox = null;
      for (let k = 0; k < 7 && !prox; k++) {
        const dd = (dia + k) % 7;
        prox = grilla.filter((p) => p.dias.includes(dd) && (k > 0 || min(p.desde) >= (actual ? min(actual.hasta) : m + 1)))
          .sort((a, b) => min(a.desde) - min(b.desde))[0] || null;
        if (prox) prox = { ...prox, hoy: k === 0, manana: k === 1 };
      }
      const de = $('[data-despues]');
      if (prox) {
        $('[data-dprog]').textContent = prox.nombre + ' · ' + (prox.hoy ? '' : prox.manana ? 'mañana ' : '') + prox.desde;
        de.hidden = false;
      } else de.hidden = true;
    }
    document.addEventListener('astro:page-load', pintar);
    setInterval(pintar, 60000);
  })();
</script>

<style>
  .al-aire-box {
    position: relative; overflow: hidden; isolation: isolate;
    background: radial-gradient(circle at 85% 10%, #5a1a9e, var(--violeta) 55%, var(--violeta-noche));
    color: #fff; border-radius: var(--radio); padding: 20px 20px 18px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .mano {
    position: absolute; z-index: -1; right: -40px; bottom: -40px; width: 200px; height: 200px;
    background: var(--fucsia); opacity: 0.14; transform: rotate(-14deg);
    -webkit-mask: url('/favicon.svg') center / contain no-repeat; mask: url('/favicon.svg') center / contain no-repeat;
  }
  .cab { display: flex; justify-content: space-between; align-items: center; margin: 0 0 10px; }
  .luz {
    display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; border-radius: 6px;
    background: #e3152f; color: #fff; font-size: 12px; font-weight: 900; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.35), 0 0 16px 1px rgba(227, 21, 47, 0.7);
  }
  .luz i { width: 8px; height: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 6px #fff; }
  .frec { font-size: 22px; font-weight: 900; color: var(--amarillo); letter-spacing: -0.02em; }
  .ahora-lbl { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fucsia); }
  .prog { margin: 0; font-size: 24px; font-weight: 900; line-height: 1.1; }
  .cond { margin: 0; font-size: 14px; color: #d8c8ee; }
  .tiempo { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
  .tiempo[hidden] { display: none; }
  .barra { flex: 1; height: 5px; border-radius: 3px; background: rgba(255, 255, 255, 0.18); overflow: hidden; }
  .barra span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--fucsia), var(--amarillo)); }
  .horas { font-size: 12px; font-weight: 700; color: #d8c8ee; white-space: nowrap; }
  .eq { display: flex; align-items: flex-end; gap: 4px; height: 34px; margin: 12px 0 4px; }
  .eq i { width: 6px; height: 30%; border-radius: 2px; background: linear-gradient(to top, var(--fucsia), var(--amarillo)); opacity: 0.55; }
  .escuchar {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px; margin-top: 8px;
    background: var(--amarillo); color: var(--violeta-noche); border: 0; border-radius: 999px;
    padding: 12px 18px; font: inherit; font-size: 14px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;
  }
  .escuchar .ic-pausa, .escuchar .t-pausa { display: none; }
  :global(html[data-radio='sonando']) .escuchar .ic-play, :global(html[data-radio='sonando']) .escuchar .t-play { display: none; }
  :global(html[data-radio='sonando']) .escuchar .ic-pausa, :global(html[data-radio='sonando']) .escuchar .t-pausa { display: inline; }
  .despues { display: flex; flex-direction: column; gap: 2px; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.15); }
  .despues[hidden] { display: none; }
  .d-lbl { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amarillo); }
  .d-prog { font-size: 15px; font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    .luz { animation: titilar 2.4s ease-in-out infinite; }
    @keyframes titilar { 0%, 100% { opacity: 1; } 50% { opacity: 0.8; } }
    .eq i { animation: eq 1.1s ease-in-out infinite alternate; animation-play-state: paused; }
    :global(html[data-radio='sonando']) .eq i { animation-play-state: running; opacity: 1; }
    .eq i:nth-child(2) { animation-delay: -0.3s; } .eq i:nth-child(3) { animation-delay: -0.7s; }
    .eq i:nth-child(4) { animation-delay: -0.15s; } .eq i:nth-child(5) { animation-delay: -0.9s; }
    .eq i:nth-child(6) { animation-delay: -0.45s; } .eq i:nth-child(7) { animation-delay: -0.6s; }
    @keyframes eq { 0% { height: 15%; } 50% { height: 90%; } 100% { height: 40%; } }
  }
</style>
