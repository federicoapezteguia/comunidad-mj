---
// Logo de la señal: FM 99.9 Marcos Juárez – Comunidad FAN (PNG transparente).
import { SITE } from '../config';
interface Props { tam?: 'normal' | 'chico' }
const { tam = 'normal' } = Astro.props;
const l = SITE.logoSenal;
---
<img src={l.src} alt={l.alt} title={l.titulo} width={l.w} height={l.h} class:list={['logo', tam]} fetchpriority="high" />

<style>
  .logo { height: 92px; width: auto; display: block; filter: drop-shadow(0 2px 6px rgba(45, 0, 93, 0.25)); }
  .chico { height: 56px; }
  @media (max-width: 480px) {
    .logo { height: 72px; }
  }
</style>
