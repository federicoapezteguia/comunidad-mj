---
// Logo oficial de Comunidad FAN (public/logo.svg) + rótulo de la señal.
interface Props { tam?: 'normal' | 'chico' }
const { tam = 'normal' } = Astro.props;
---
<span class:list={['logo', tam]}>
  <img src="/logo.svg" alt="Comunidad FAN" width="1346" height="568" />
  <span class="senal">Marcos Juárez</span>
</span>

<style>
  .logo { display: inline-flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  img { height: 58px; width: auto; display: block; }
  .chico img { height: 46px; }
  .senal {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blanco);
    background: var(--violeta);
    padding: 3px 7px 2px;
    border-radius: 3px;
    line-height: 1.2;
  }
  @media (max-width: 480px) {
    img { height: 48px; }
  }
</style>
