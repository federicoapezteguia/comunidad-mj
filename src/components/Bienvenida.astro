---
// Bloque y ventana de bienvenida por el lanzamiento del sitio.
// Se muestran solo en la portada y desaparecen solos en la fecha de HASTA,
// sin necesidad de tocar nada. La ventana aparece una vez por navegador.
import { SITE } from '../config';

const HASTA = '2026-12-15T23:59:59-03:00';
const vigente = Date.now() < new Date(HASTA).getTime();
const l = SITE.logoSenal;
---

{
  vigente && (
    <section class="bienv wrap" data-bienvenida data-hasta={HASTA} aria-labelledby="bienv-t">
      <div class="caja">
        <button type="button" class="cerrar" data-bienv-cerrar aria-label="Cerrar la bienvenida">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <img src={l.src} alt="" width={l.w} height={l.h} class="marca" />

        <div class="texto">
          <p class="volanta">Nuevo sitio</p>
          <h2 id="bienv-t">Ya estamos online</h2>
          <p class="bajada">
            Las noticias de Marcos Juárez, la región, Córdoba y el país, todos los días. Y la FM 99.9
            en vivo, desde donde estés.
          </p>

          <ul class="puntos">
            <li>Lo que pasa en la ciudad y en la zona, actualizado todos los días</li>
            <li>La radio en vivo, desde el celular o la computadora</li>
            <li>El clima, las encuestas y lo más leído de la semana</li>
          </ul>

          <div class="acciones">
            <button type="button" class="boton boton-amarillo" data-radio-toggle>
              <span>Escuchar la radio en vivo</span>
            </button>
            <a class="boton boton-linea" href={SITE.redes.instagram} target="_blank" rel="noopener">
              <span>Seguinos en Instagram</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  vigente && (
    <dialog class="pop" data-pop data-hasta={HASTA} aria-labelledby="pop-t">
      <div class="tarjeta">
        <button type="button" class="cerrar" data-pop-cerrar aria-label="Cerrar">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
            />
          </svg>
        </button>
        <img src={l.src} alt="" width={l.w} height={l.h} class="marca" />
        <h2 id="pop-t">Bienvenido al nuevo sitio</h2>
        <p>
          Comunidad FAN Marcos Juárez ya está online: las noticias de la ciudad y la región todos los
          días, y la FM 99.9 en vivo desde donde estés.
        </p>
        <div class="acciones">
          <button type="button" class="boton boton-amarillo" data-pop-cerrar>
            <span>Empezar a leer</span>
          </button>
          <button type="button" class="boton boton-linea" data-radio-toggle data-pop-cerrar>
            <span>Escuchar la radio</span>
          </button>
        </div>
      </div>
    </dialog>
  )
}

<style>
  /* ---------- Bloque de la portada ---------- */
  .bienv {
    margin: 0 auto 26px;
  }

  .caja {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 30px;
    align-items: center;
    padding: 30px 34px;
    border-radius: 16px;
    color: var(--blanco);
    background:
      radial-gradient(110% 120% at 100% 0%, rgba(255, 0, 255, 0.45) 0%, rgba(255, 0, 255, 0) 60%),
      linear-gradient(135deg, var(--violeta) 0%, var(--violeta-noche) 100%);
    box-shadow: 0 16px 36px rgba(45, 0, 93, 0.18);
    overflow: hidden;
  }

  .caja::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/img/mosaico-manito.svg') 0 0 / 230px;
    opacity: 0.06;
    pointer-events: none;
  }

  .marca {
    position: relative;
    height: 104px;
    width: auto;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
  }

  .texto {
    position: relative;
    min-width: 0;
  }

  .volanta {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--amarillo);
  }

  .bienv h2 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-size: clamp(26px, 3.6vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .bajada {
    margin: 12px 0 0;
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--lila);
  }

  .puntos {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .puntos li {
    position: relative;
    padding-left: 22px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--blanco);
  }

  .puntos li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.58em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fucsia);
  }

  .acciones {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .boton-linea {
    background: transparent;
    color: var(--blanco);
    border: 2px solid rgba(233, 221, 245, 0.55);
  }

  .boton-linea:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--blanco);
    color: var(--blanco);
  }

  .cerrar {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: var(--blanco);
    background: rgba(255, 255, 255, 0.14);
    transition: background 0.15s ease;
  }

  .cerrar:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* ---------- Ventana ---------- */
  /* Va en un <dialog> para que el navegador la ponga en la capa superior:
     así no la afecta ningún recorte ni z-index de la página. */
  .pop {
    width: min(460px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 40px);
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
  }

  .pop::backdrop {
    background: rgba(20, 0, 40, 0.68);
    backdrop-filter: blur(2px);
  }

  .tarjeta {
    position: relative;
    max-height: calc(100dvh - 40px);
    overflow: auto;
    padding: 34px 30px 30px;
    border-radius: 18px;
    text-align: center;
    color: var(--blanco);
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(255, 0, 255, 0.45) 0%, rgba(255, 0, 255, 0) 62%),
      linear-gradient(180deg, var(--violeta) 0%, var(--violeta-noche) 100%);
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.45);
  }

  .tarjeta .marca {
    height: 86px;
    margin: 0 auto 16px;
  }

  .tarjeta h2 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-size: 27px;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .tarjeta p {
    margin: 12px auto 0;
    max-width: 38ch;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--lila);
  }

  .tarjeta .acciones {
    justify-content: center;
  }

  .pop[open]::backdrop {
    animation: aparecer 0.25s ease both;
  }

  .pop[open] .tarjeta {
    animation: subir 0.32s cubic-bezier(0.2, 0.8, 0.3, 1) both;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pop[open]::backdrop,
    .pop[open] .tarjeta {
      animation: none;
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 760px) {
    .caja {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px 20px;
      text-align: center;
      justify-items: center;
    }

    .marca {
      height: 64px;
    }

    .bajada {
      margin-top: 10px;
      font-size: 15px;
    }

    /* En el celular el bloque no puede comerse la pantalla entera:
       el detalle queda en la ventana de bienvenida. */
    .puntos {
      display: none;
    }

    .acciones {
      justify-content: center;
    }

    .acciones .boton {
      flex: 1 1 100%;
    }
  }

  @media (max-width: 420px) {
    .tarjeta {
      padding: 30px 20px 24px;
    }

    .tarjeta .marca {
      height: 70px;
    }

    .tarjeta h2 {
      font-size: 23px;
    }
  }
</style>

<noscript>
  <style>
    [data-bienv-cerrar] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  const CLAVE_BLOQUE = 'bienvenida-bloque-1';
  const CLAVE_POP = 'bienvenida-pop-1';

  function guardado(clave: string): boolean {
    try {
      return localStorage.getItem(clave) === '1';
    } catch {
      return false;
    }
  }

  function guardar(clave: string): void {
    try {
      localStorage.setItem(clave, '1');
    } catch {
      /* navegación privada: se vuelve a ver, no es grave */
    }
  }

  function vencido(el: Element | null): boolean {
    const h = el?.getAttribute('data-hasta');
    return !h || Date.now() > new Date(h).getTime();
  }

  function bienvenida(): void {
    const bloque = document.querySelector<HTMLElement>('[data-bienvenida]');
    if (bloque?.dataset.listo === '1') return;
    if (bloque) bloque.dataset.listo = '1';
    const pop = document.querySelector<HTMLDialogElement>('[data-pop]');

    // Por si el sitio no se vuelve a publicar: la fecha también se controla acá.
    if (bloque && vencido(bloque)) bloque.remove();
    if (pop && vencido(pop)) pop.remove();

    const vivoBloque = document.querySelector<HTMLElement>('[data-bienvenida]');
    const vivoPop = document.querySelector<HTMLDialogElement>('[data-pop]');

    if (vivoBloque) {
      if (guardado(CLAVE_BLOQUE)) {
        vivoBloque.remove();
      } else {
        vivoBloque.querySelector('[data-bienv-cerrar]')?.addEventListener('click', () => {
          guardar(CLAVE_BLOQUE);
          vivoBloque.remove();
        });
      }
    }

    if (!vivoPop) return;
    if (guardado(CLAVE_POP)) {
      vivoPop.remove();
      return;
    }

    // El <dialog> se encarga del foco, de la tecla Escape y de la capa superior.
    vivoPop.addEventListener('close', () => {
      document.documentElement.style.removeProperty('overflow');
      vivoPop.remove();
    });

    // Un clic afuera de la tarjeta la cierra.
    vivoPop.addEventListener('click', (e) => {
      if (e.target === vivoPop) vivoPop.close();
    });

    vivoPop
      .querySelectorAll('[data-pop-cerrar]')
      .forEach((b) => b.addEventListener('click', () => vivoPop.close()));

    window.setTimeout(() => {
      if (!document.body.contains(vivoPop) || vivoPop.open) return;
      guardar(CLAVE_POP);
      document.documentElement.style.overflow = 'hidden';
      if (typeof vivoPop.showModal === 'function') vivoPop.showModal();
      else vivoPop.setAttribute('open', '');
    }, 1600);
  }

  document.addEventListener('astro:page-load', bienvenida);
</script>
