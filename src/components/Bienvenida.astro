---
// Bloque y ventana de bienvenida por el lanzamiento del sitio.
// Se muestran solo en la portada y desaparecen solos en la fecha de HASTA,
// sin necesidad de tocar nada. La ventana aparece una vez por navegador.
//
// La pieza se apoya en lo más propio de la radio: su lugar en el dial.
// El 99.9 es el elemento grande; todo lo demás queda quieto alrededor.
import { SITE } from '../config';

const HASTA = '2026-12-15T23:59:59-03:00';
const vigente = Date.now() < new Date(HASTA).getTime();
---

{
  vigente && (
    <section class="bienv wrap" data-bienvenida data-hasta={HASTA} aria-labelledby="bienv-t">
      <div class="caja">
        <button type="button" class="cerrar" data-bienv-cerrar aria-label="Cerrar la bienvenida">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <div class="sintonia" aria-hidden="true">
          <p class="fm">FM</p>
          <p class="num">99.9</p>
          <p class="lugar">Marcos Juárez</p>
          <div class="escala">
            <span class="aguja" />
          </div>
        </div>

        <div class="texto">
          <h2 id="bienv-t">
            Nos escuchabas.<br />
            Ahora también podés leernos.
          </h2>
          <p class="bajada">
            Las noticias de Marcos Juárez, la región, Córdoba y el país, todos los días. Y la FM
            99.9 en vivo, desde donde estés.
          </p>

          <ul class="tira">
            <li>Lo que pasa en la ciudad</li>
            <li>La radio en vivo</li>
            <li>El clima y lo más leído</li>
          </ul>

          <div class="acciones">
            <button type="button" class="boton boton-amarillo" data-radio-toggle>
              <span>Escuchar la radio en vivo</span>
            </button>
            <a class="enlace" href={SITE.redes.instagram} target="_blank" rel="noopener">
              Seguinos en Instagram
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  vigente && (
    <dialog class="pop" data-pop data-hasta={HASTA} aria-labelledby="pop-t">
      <div class="tarjeta">
        <button type="button" class="cerrar" data-pop-cerrar aria-label="Cerrar">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <p class="dial-chico">
          <span>FM</span> 99.9 <span>Marcos Juárez</span>
        </p>

        <h2 id="pop-t">
          Nos escuchabas.<br />
          Ahora también podés leernos.
        </h2>
        <p>
          Las noticias de la ciudad y la región, todos los días, y la radio en vivo desde donde
          estés.
        </p>

        <div class="acciones">
          <button type="button" class="boton boton-amarillo" data-pop-cerrar>
            <span>Entrar al sitio</span>
          </button>
          <button type="button" class="enlace" data-radio-toggle data-pop-cerrar>
            Escuchar la radio
          </button>
        </div>
      </div>
    </dialog>
  )
}

<style>
  /* ---------- Bloque de la portada ---------- */
  .bienv {
    margin: 0 auto 26px;
  }

  .caja {
    position: relative;
    display: grid;
    grid-template-columns: minmax(230px, 300px) 1fr;
    gap: 44px;
    align-items: center;
    padding: 38px 42px 40px;
    border-radius: 14px;
    color: var(--blanco);
    background:
      radial-gradient(90% 130% at 16% 110%, rgba(255, 0, 255, 0.34) 0%, rgba(255, 0, 255, 0) 58%),
      linear-gradient(104deg, #2d005d 0%, #1b0038 62%, #14002b 100%);
    overflow: hidden;
  }

  .caja::after {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60%;
    height: 180%;
    background: url('/img/mosaico-manito.svg') 0 0 / 190px;
    opacity: 0.05;
    transform: rotate(-8deg);
    pointer-events: none;
  }

  /* El dial: lo único grande de la pieza */
  .sintonia {
    position: relative;
    text-align: left;
  }

  .fm,
  .lugar {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgba(233, 221, 245, 0.75);
  }

  .num {
    margin: -2px 0 2px -0.055em;
    font-family: var(--fuente-titulo);
    font-size: clamp(76px, 9.5vw, 128px);
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: var(--fucsia);
    text-shadow: 0 0 46px rgba(255, 0, 255, 0.5);
  }

  .escala {
    position: relative;
    margin-top: 20px;
    height: 22px;
    background: repeating-linear-gradient(
      90deg,
      rgba(233, 221, 245, 0.5) 0 2px,
      transparent 2px 13px
    );
    -webkit-mask-image: linear-gradient(90deg, #000 0 58%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0 58%, transparent 100%);
  }

  .aguja {
    position: absolute;
    top: -7px;
    left: 34%;
    width: 3px;
    height: 36px;
    border-radius: 2px;
    background: var(--amarillo);
    box-shadow: 0 0 14px rgba(255, 204, 51, 0.8);
  }

  .texto {
    min-width: 0;
  }

  .bienv h2 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-size: clamp(25px, 3vw, 39px);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .bajada {
    margin: 16px 0 0;
    max-width: 56ch;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--lila);
  }

  /* Tres pares: la línea divisoria dice que son pares, el bolito no decía nada */
  .tira {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    font-size: 13.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.86);
  }

  .tira li + li {
    padding-left: 18px;
    border-left: 1px solid rgba(233, 221, 245, 0.28);
  }

  .acciones {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }

  /* Una sola acción sólida: el segundo camino es un enlace, no compite */
  .enlace {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--blanco);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: rgba(255, 0, 255, 0.85);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.15s ease;
  }

  .enlace:hover {
    text-decoration-color: var(--amarillo);
  }

  .cerrar {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.1);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .cerrar:hover {
    background: rgba(255, 255, 255, 0.24);
    color: var(--blanco);
  }

  /* El único momento con movimiento: la aguja entra una vez y se queda */
  @media (prefers-reduced-motion: no-preference) {
    .aguja {
      animation: sintonizar 0.9s cubic-bezier(0.22, 0.9, 0.24, 1) 0.15s both;
    }

    .num {
      animation: encender 0.7s ease 0.1s both;
    }
  }

  @keyframes sintonizar {
    from {
      left: 2%;
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes encender {
    from {
      opacity: 0;
      text-shadow: 0 0 0 rgba(255, 0, 255, 0);
    }
  }

  /* ---------- Ventana ---------- */
  .pop {
    width: min(440px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100dvh - 40px);
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
  }

  .pop::backdrop {
    background: rgba(14, 0, 30, 0.72);
    backdrop-filter: blur(3px);
  }

  .tarjeta {
    position: relative;
    max-height: calc(100dvh - 40px);
    overflow: auto;
    padding: 34px 32px 30px;
    border-radius: 14px;
    color: var(--blanco);
    background:
      radial-gradient(80% 110% at 0% 100%, rgba(255, 0, 255, 0.3) 0%, rgba(255, 0, 255, 0) 60%),
      linear-gradient(150deg, #2d005d 0%, #1b0038 70%, #14002b 100%);
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.5);
  }

  .dial-chico {
    margin: 0 0 14px;
    font-family: var(--fuente-titulo);
    font-size: 26px;
    letter-spacing: -0.03em;
    color: var(--fucsia);
  }

  .dial-chico span {
    font-family: var(--fuente);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgba(233, 221, 245, 0.7);
  }

  .tarjeta h2 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-size: 27px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tarjeta p:not(.dial-chico) {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--lila);
  }

  .tarjeta .acciones {
    margin-top: 24px;
  }

  .pop[open]::backdrop {
    animation: aparecer 0.25s ease both;
  }

  .pop[open] .tarjeta {
    animation: subir 0.32s cubic-bezier(0.2, 0.8, 0.3, 1) both;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pop[open]::backdrop,
    .pop[open] .tarjeta {
      animation: none;
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .caja {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 30px 24px 32px;
    }

    .sintonia {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      column-gap: 14px;
    }

    .fm {
      grid-row: 1;
    }

    .num {
      grid-row: 2;
      grid-column: 1;
      font-size: clamp(60px, 17vw, 86px);
      margin-bottom: 0;
    }

    .lugar {
      grid-row: 2;
      grid-column: 2;
      align-self: end;
      padding-bottom: 0.45em;
    }

    .escala {
      grid-row: 3;
      grid-column: 1 / -1;
      margin-top: 14px;
    }

    .bajada {
      font-size: 15.5px;
    }

    .tira {
      display: none;
    }

    .acciones .boton {
      flex: 1 1 100%;
    }
  }

  /* En el celular la ventana entra desde abajo, como una hoja */
  @media (max-width: 560px) {
    .pop {
      width: 100%;
      max-width: 100%;
      margin: auto auto 0;
      max-height: 88dvh;
    }

    .tarjeta {
      padding: 28px 22px 26px;
      border-radius: 18px 18px 0 0;
      max-height: 88dvh;
    }

    .tarjeta h2 {
      font-size: 24px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .pop[open] .tarjeta {
        animation: hoja 0.34s cubic-bezier(0.2, 0.8, 0.3, 1) both;
      }
    }

    .tarjeta .acciones .boton {
      flex: 1 1 100%;
    }

    .tarjeta .acciones {
      justify-content: center;
    }
  }

  @keyframes hoja {
    from {
      transform: translateY(100%);
    }
  }
</style>

<noscript>
  <style>
    [data-bienv-cerrar] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  const CLAVE_BLOQUE = 'bienvenida-bloque-1';
  const CLAVE_POP = 'bienvenida-pop-1';

  function guardado(clave: string): boolean {
    try {
      return localStorage.getItem(clave) === '1';
    } catch {
      return false;
    }
  }

  function guardar(clave: string): void {
    try {
      localStorage.setItem(clave, '1');
    } catch {
      /* navegación privada: se vuelve a ver, no es grave */
    }
  }

  function vencido(el: Element | null): boolean {
    const h = el?.getAttribute('data-hasta');
    return !h || Date.now() > new Date(h).getTime();
  }

  function bienvenida(): void {
    const bloque = document.querySelector<HTMLElement>('[data-bienvenida]');
    if (bloque?.dataset.listo === '1') return;
    if (bloque) bloque.dataset.listo = '1';
    const pop = document.querySelector<HTMLDialogElement>('[data-pop]');

    // Por si el sitio no se vuelve a publicar: la fecha también se controla acá.
    if (bloque && vencido(bloque)) bloque.remove();
    if (pop && vencido(pop)) pop.remove();

    const vivoBloque = document.querySelector<HTMLElement>('[data-bienvenida]');
    const vivoPop = document.querySelector<HTMLDialogElement>('[data-pop]');

    if (vivoBloque) {
      if (guardado(CLAVE_BLOQUE)) {
        vivoBloque.remove();
      } else {
        vivoBloque.querySelector('[data-bienv-cerrar]')?.addEventListener('click', () => {
          guardar(CLAVE_BLOQUE);
          vivoBloque.remove();
        });
      }
    }

    if (!vivoPop) return;
    if (guardado(CLAVE_POP)) {
      vivoPop.remove();
      return;
    }

    // El <dialog> se encarga del foco, de la tecla Escape y de la capa superior.
    vivoPop.addEventListener('close', () => {
      document.documentElement.style.removeProperty('overflow');
      vivoPop.remove();
    });

    // Un clic afuera de la tarjeta la cierra.
    vivoPop.addEventListener('click', (e) => {
      if (e.target === vivoPop) vivoPop.close();
    });

    vivoPop
      .querySelectorAll('[data-pop-cerrar]')
      .forEach((b) => b.addEventListener('click', () => vivoPop.close()));

    window.setTimeout(() => {
      if (!document.body.contains(vivoPop) || vivoPop.open) return;
      guardar(CLAVE_POP);
      document.documentElement.style.overflow = 'hidden';
      if (typeof vivoPop.showModal === 'function') vivoPop.showModal();
      else vivoPop.setAttribute('open', '');
    }, 1600);
  }

  document.addEventListener('astro:page-load', bienvenida);
</script>
