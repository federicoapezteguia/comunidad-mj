---
// Adornos de línea (estilo de la torre de radio): dibujos grandes y suaves en los márgenes,
// detrás del contenido, con animación lenta. Cada uno se relaciona con su sección.
type Tipo = 'silos' | 'microfono' | 'auriculares' | 'pelota' | 'parabolica' | 'cassette' | 'parlante' | 'mapa';
interface Props { tipo: Tipo; lado?: 'izq' | 'der'; arriba?: string; claro?: boolean; sobreFucsia?: boolean; ancho?: number }
const { tipo, lado = 'der', arriba = '40px', claro = false, sobreFucsia = false, ancho = 190 } = Astro.props;
---
<div class:list={['adorno', `ad-${tipo}`, lado, { claro, 'sobre-fucsia': sobreFucsia }]} style={`--arriba:${arriba};--ancho:${ancho}px`} aria-hidden="true">
  <svg viewBox="0 0 200 260" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    {tipo === 'silos' && (
      <g>
        <circle class="ac sol" cx="38" cy="52" r="15"></circle>
        <g class="ac sol rayos"><path d="M38 26v-8M38 86v-8M12 52H4M72 52h-8M20 34l-6-6M62 76l-6-6M56 34l6-6M14 76l6-6"></path></g>
        <path d="M6 250H194"></path>
        <path d="M18 250V118Q36 92 54 118V250M18 150H54M18 185H54M18 220H54"></path>
        <path d="M60 250V100Q81 70 102 100V250M60 135H102M60 170H102M60 205H102M60 238H102M81 100V78"></path>
        <path d="M134 250L156 128L178 250M139 222H173M144 192H168M149 160H163M139 222L168 192M173 222L144 192M144 192L163 160M168 192L149 160"></path>
        <path d="M156 118L192 110V126Z"></path>
        <g class="aspas"><circle cx="156" cy="118" r="26"></circle><path d="M156 92V144M130 118H182M138 100L174 136M174 100L138 136"></path></g>
      </g>
    )}
    {tipo === 'microfono' && (
      <g>
        <rect x="74" y="34" width="52" height="96" rx="26"></rect>
        <path d="M80 62H120M78 82H122M80 102H120"></path>
        <path d="M60 92V102A40 40 0 0 0 140 102V92"></path>
        <path d="M100 142V206M70 206H130M84 206L78 226H122L116 206"></path>
        <g class="ac ondas"><path class="o1" d="M48 64A60 60 0 0 0 48 140"></path><path class="o2" d="M30 48A84 84 0 0 0 30 156"></path><path class="o1" d="M152 64A60 60 0 0 1 152 140"></path><path class="o2" d="M170 48A84 84 0 0 1 170 156"></path></g>
      </g>
    )}
    {tipo === 'auriculares' && (
      <g>
        <path d="M44 150V128A56 56 0 0 1 156 128V150"></path>
        <rect x="30" y="140" width="30" height="62" rx="12"></rect>
        <rect x="140" y="140" width="30" height="62" rx="12"></rect>
        <path d="M60 156H70V188H60M140 156H130V188H140"></path>
        <g class="ac nota n1"><path d="M92 92V54L118 48V84"></path><circle cx="86" cy="94" r="7"></circle><circle cx="112" cy="86" r="7"></circle></g>
        <g class="ac nota n2"><path d="M128 60V30"></path><circle cx="122" cy="62" r="7"></circle><path d="M128 30Q142 36 138 48"></path></g>
      </g>
    )}
    {tipo === 'pelota' && (
      <g>
        <path d="M6 236H194"></path><path d="M70 236A30 12 0 0 1 130 236"></path>
        <ellipse class="sombra" cx="100" cy="238" rx="34" ry="6"></ellipse>
        <g class="bote">
          <circle cx="100" cy="150" r="44"></circle>
          <path d="M100 132L117 144L111 164H89L83 144Z"></path>
          <path d="M100 132V106M117 144L140 136M111 164L124 184M89 164L76 184M83 144L60 136"></path>
          <g class="ac"><path d="M40 120H22M44 140H18M40 160H24"></path></g>
        </g>
      </g>
    )}
    {tipo === 'parabolica' && (
      <g>
        <path d="M40 80A70 70 0 0 0 130 170Z"></path>
        <path d="M85 125L118 92M118 92m-6 0a6 6 0 1 0 12 0a6 6 0 1 0 -12 0"></path>
        <path d="M80 140L74 236M74 236L44 236M74 236L104 236M76 196L100 236M72 196L48 236"></path>
        <g class="ac ondas"><path class="o1" d="M132 70A30 30 0 0 1 148 104"></path><path class="o2" d="M140 48A56 56 0 0 1 170 112"></path><path class="o3" d="M150 26A82 82 0 0 1 192 120"></path></g>
      </g>
    )}
    {tipo === 'cassette' && (
      <g>
        <rect x="16" y="66" width="168" height="112" rx="10"></rect>
        <rect x="34" y="80" width="132" height="30" rx="4"></rect>
        <rect x="52" y="118" width="96" height="30" rx="14"></rect>
        <g class="rueda r1"><circle cx="72" cy="133" r="11"></circle><path d="M72 122V144M61 133H83"></path></g>
        <g class="rueda r2"><circle cx="128" cy="133" r="11"></circle><path d="M128 122V144M117 133H139"></path></g>
        <path d="M48 178L58 158H142L152 178"></path>
        <g class="ac"><path d="M44 95H120M44 102H96"></path></g>
      </g>
    )}
    {tipo === 'parlante' && (
      <g>
        <rect x="50" y="28" width="100" height="196" rx="12"></rect>
        <circle cx="100" cy="68" r="14"></circle><circle cx="100" cy="68" r="5"></circle>
        <g class="cono"><circle cx="100" cy="152" r="40"></circle><circle cx="100" cy="152" r="22"></circle><circle cx="100" cy="152" r="7"></circle></g>
        <g class="ac anillos"><circle class="o1" cx="100" cy="152" r="56"></circle><circle class="o2" cx="100" cy="152" r="72"></circle></g>
      </g>
    )}
    {tipo === 'mapa' && (
      <g>
        <path d="M20 70H180M20 110H180M20 150H180M20 190H180M40 50V210M80 50V210M120 50V210M160 50V210" stroke-width="2"></path>
        <path d="M14 214L186 46" stroke-width="5"></path>
        <g class="ac ondas"><circle class="o1" cx="100" cy="122" r="26"></circle><circle class="o2" cx="100" cy="122" r="48"></circle><circle class="o3" cx="100" cy="122" r="70"></circle></g>
        <path class="ac pin" d="M100 136C100 136 78 112 78 96A22 22 0 0 1 122 96C122 112 100 136 100 136Z" fill="currentColor"></path>
        <circle cx="100" cy="96" r="7" fill="#fff" stroke="none"></circle>
        <text x="100" y="244" text-anchor="middle" font-size="15" font-weight="900" fill="currentColor" stroke="none" font-family="'Montserrat Variable', Montserrat, sans-serif" letter-spacing="1.5">MARCOS JUÁREZ</text>
      </g>
    )}
  </svg>
</div>

<style>
  .adorno {
    position: absolute; z-index: -1; top: var(--arriba); width: var(--ancho); color: var(--violeta);
    opacity: 0.32; pointer-events: none;
  }
  .adorno svg { width: 100%; height: auto; display: block; overflow: visible; }
  .der { right: max(-200px, calc((100vw - 100%) / -2 + 8px)); }
  .izq { left: max(-200px, calc((100vw - 100%) / -2 + 8px)); }
  .claro { color: #d9b8ff; opacity: 0.22; }
  .ac { color: var(--fucsia); }
  .claro .ac { color: var(--amarillo); }
  .sobre-fucsia { opacity: 0.35; }
  .sobre-fucsia .ac { color: var(--violeta-noche); }
  @media (max-width: 900px) { .adorno { display: none; } }

  @media (prefers-reduced-motion: no-preference) {
    .aspas { transform-origin: 156px 118px; animation: girar 9s linear infinite; }
    .rayos { transform-origin: 38px 52px; animation: girar 40s linear infinite; }
    .sol { animation: amanecer 6s ease-in-out infinite alternate; }
    .ondas .o1, .ondas .o2, .ondas .o3, .anillos .o1, .anillos .o2 { animation: latir 2.4s ease-in-out infinite; }
    .ondas .o2, .anillos .o2 { animation-delay: 0.4s; } .ondas .o3 { animation-delay: 0.8s; }
    :global(html[data-radio='sonando']) .ondas > *, :global(html[data-radio='sonando']) .anillos > * { animation-duration: 0.9s; }
    .nota { animation: flotar 4s ease-in-out infinite; } .n2 { animation-delay: 2s; }
    .bote { animation: rebotar 1.6s cubic-bezier(0.5, 0, 0.5, 1) infinite; }
    .sombra { transform-origin: 100px 238px; animation: sombra 1.6s cubic-bezier(0.5, 0, 0.5, 1) infinite; }
    .rueda { animation: girar 3s linear infinite; } .r1 { transform-origin: 72px 133px; } .r2 { transform-origin: 128px 133px; }
    .cono { transform-origin: 100px 152px; animation: vibrar 0.5s ease-in-out infinite alternate; }
    .pin { animation: saltar 2.4s ease-in-out infinite; }
    @keyframes girar { to { transform: rotate(360deg); } }
    @keyframes amanecer { from { transform: translateY(8px); } to { transform: translateY(-6px); } }
    @keyframes latir { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
    @keyframes flotar { 0% { transform: translateY(14px); opacity: 0; } 30%, 70% { opacity: 1; } 100% { transform: translateY(-22px); opacity: 0; } }
    @keyframes rebotar { 0%, 100% { transform: translateY(-46px); } 50% { transform: translateY(42px); } }
    @keyframes sombra { 0%, 100% { transform: scale(0.55); opacity: 0.4; } 50% { transform: scale(1); opacity: 1; } }
    @keyframes vibrar { from { transform: scale(0.97); } to { transform: scale(1.03); } }
    @keyframes saltar { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  }
</style>
