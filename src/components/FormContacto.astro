---
// Formulario de contacto por pasos. Sin JavaScript se ve como un
// formulario normal, con todos los campos a la vista y un solo botón.
//
// motivo="publicidad" saltea el primer paso: se usa en la página de
// publicidad, donde el visitante ya eligió de qué quiere hablar.
interface Props {
  motivo?: 'publicidad' | '';
}
const { motivo = '' } = Astro.props;
const fijo = motivo === 'publicidad' ? 'publicidad' : '';

const opciones = [
  {
    id: 'publicidad',
    titulo: 'Publicitar mi negocio',
    texto: 'Spots en la FM, banners en el sitio y notas de contenido de marca.',
    icono: 'M3 10v4h4l5 4V6l-5 4H3zM16 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12',
  },
  {
    id: 'otro',
    titulo: 'Otra consulta',
    texto: 'Un mensaje para la radio, una corrección o cualquier otra cosa.',
    icono: 'M21 12a9 9 0 0 1-13 8l-5 1 1-5a9 9 0 1 1 17-4z',
  },
];
---

<div class="asistente" data-asistente data-fijo={fijo}>
  <div class="cabecera" data-cabecera>
    <span class="paso-n" data-contador>Paso 1</span>
    <span class="barra" aria-hidden="true">
      {!fijo && <span data-tramo="1"></span>}
      <span data-tramo="2"></span><span data-tramo="3"></span>
    </span>
  </div>
  <noscript>
    <!-- Sin JavaScript no hay pasos, así que el contador sobra -->
    <style>.cabecera, .volver, .avanza { display: none !important; }</style>
  </noscript>

  <form method="post" action="/api/contacto.php" novalidate>
    <button type="button" class="volver" data-volver hidden>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      Volver
    </button>

    <!-- Paso 1: no se muestra cuando el motivo ya viene fijado -->
    {fijo ? (
      <input type="hidden" name="motivo" value={fijo} />
    ) : (
      <fieldset class="paso" data-paso="1">
        <legend class="preg">¿Qué necesitás?</legend>
        <p class="sub">Elegí lo que más se parezca a tu caso.</p>
        <ul class="opciones">
          {opciones.map((o, i) => (
            <li>
              <label class="opcion">
                <input type="radio" name="motivo" value={o.id} required checked={i === 0} />
                <span class="ico" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={o.icono} /></svg>
                </span>
                <span class="txt">
                  <strong>{o.titulo}</strong>
                  <small>{o.texto}</small>
                </span>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>
    )}

    <!-- Paso 2 -->
    <fieldset class="paso" data-paso="2">
      <legend class="preg" data-preg2>Contanos de qué se trata</legend>
      <p class="sub" data-sub2>¿Algo que quieras decirnos?</p>

      <p class="campo" data-solo="publicidad">
        <label for="c-negocio">Nombre de tu emprendimiento, servicio o empresa</label>
        <input id="c-negocio" name="negocio" type="text" maxlength="120" placeholder="Por ejemplo: Panadería La Esquina" />
        <span class="error" id="e-negocio" aria-live="polite"></span>
      </p>

      <p class="campo">
        <label for="c-mensaje" data-lab2>Mensaje</label>
        <textarea id="c-mensaje" name="mensaje" rows="6" maxlength="4000" required></textarea>
        <span class="error" id="e-mensaje" aria-live="polite"></span>
      </p>

      <p class="avanza"><button type="button" class="boton boton-violeta" data-sigue>Continuar</button></p>
    </fieldset>

    <!-- Paso 3 -->
    <fieldset class="paso" data-paso="3">
      <legend class="preg">¿A dónde te respondemos?</legend>
      <p class="sub">Elegí por dónde te queda más cómodo y dejanos ese dato.</p>

      <p class="campo">
        <label for="c-nombre">Tu nombre</label>
        <input id="c-nombre" name="nombre" type="text" maxlength="80" required autocomplete="name" placeholder="Nombre y apellido" />
        <span class="error" id="e-nombre" aria-live="polite"></span>
      </p>

      <fieldset class="via">
        <legend>¿Por dónde preferís?</legend>
        <div class="via-ops">
          <label class="via-op">
            <input type="radio" name="via" value="whatsapp" checked />
            <span>WhatsApp</span>
          </label>
          <label class="via-op">
            <input type="radio" name="via" value="email" />
            <span>Correo</span>
          </label>
        </div>
      </fieldset>

      <p class="campo" data-via="whatsapp">
        <label for="c-wa">Tu WhatsApp</label>
        <input id="c-wa" name="whatsapp" type="tel" maxlength="30" autocomplete="tel" placeholder="3472 123456" />
        <span class="error" id="e-whatsapp" aria-live="polite"></span>
      </p>

      <p class="campo" data-via="email">
        <label for="c-email">Tu correo</label>
        <input id="c-email" name="email" type="email" maxlength="120" autocomplete="email" placeholder="tucorreo@ejemplo.com" />
        <span class="error" id="e-email" aria-live="polite"></span>
      </p>

      <p class="nota-datos">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
        <span>Usamos tus datos solo para responderte. No se los damos a nadie ni te sumamos a ninguna lista.</span>
      </p>

      <p class="envio">
        <button type="submit" class="boton boton-violeta">Enviar mensaje</button>
        <span class="aviso" role="status"></span>
      </p>
    </fieldset>

    <p class="trampa" aria-hidden="true">
      <label for="c-sitio">No completar</label>
      <input id="c-sitio" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
    </p>
    <input type="hidden" name="abierto" value="" />
  </form>

  <div class="listo" data-listo hidden>
    <div class="tilde" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.5 5.5L20 7" /></svg>
    </div>
    <h3>Mensaje enviado</h3>
    <p>Gracias por escribirnos. Te respondemos por donde nos pediste.</p>
    <p class="mientras">
      <a href="/en-vivo/">Escuchá la radio en vivo</a> o <button type="button" class="otra" data-otra>dejá otro mensaje</button>.
    </p>
  </div>
</div>

<style>
  /* Un display propio pisa el atributo hidden, así que se fuerza acá */
  [hidden] { display: none !important; }

  /* Escala de espacios del formulario: 8 / 12 / 18 / 26 / 34 */
  .asistente {
    --pad: 26px;
    /* Un campo de 900px de ancho se lee mal: la tarjeta no pasa de acá. */
    max-width: 760px;
    border: 1px solid var(--lila);
    border-radius: 18px;
    background: var(--lila-claro);
    overflow: hidden;
    margin: 22px 0 8px;
    box-shadow: 0 14px 34px rgba(45, 0, 93, 0.1);
  }

  /* Cabecera: el paso en el que va y cuánto falta */
  .cabecera {
    display: flex; align-items: center; gap: 18px;
    padding: 13px var(--pad);
    background: var(--violeta);
  }
  .paso-n {
    font-size: 13px; font-weight: 800; color: var(--amarillo);
    white-space: nowrap; letter-spacing: 0.01em;
  }
  .barra { display: flex; gap: 6px; flex: 1; }
  .barra span {
    flex: 1; height: 5px; border-radius: 500px;
    background: rgba(255, 255, 255, 0.22);
    transition: background 0.25s ease;
  }
  .barra span[data-activo] { background: var(--fucsia); }

  form { padding: 22px var(--pad) 26px; margin: 0; }

  .volver {
    display: inline-flex; align-items: center; gap: 5px;
    margin: 0 0 14px; padding: 5px 11px 5px 8px;
    background: var(--blanco); border: 1px solid var(--lila); border-radius: 500px;
    cursor: pointer;
    font: inherit; font-size: 13.5px; font-weight: 700; color: var(--violeta-medio);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .volver:hover { color: var(--fucsia-oscuro); border-color: var(--violeta-medio); }
  .volver:focus-visible { outline: 3px solid var(--amarillo); outline-offset: 2px; }

  .paso { border: 0; margin: 0; padding: 0; min-inline-size: 0; }
  /* Sin JavaScript se ven los tres seguidos y necesitan aire entre sí */
  .paso + .paso { margin-top: 28px; }
  .preg {
    padding: 0; margin: 0;
    font-family: var(--fuente-titulo);
    font-size: clamp(21px, 3.2vw, 27px); font-weight: 700; line-height: 1.2;
    letter-spacing: -0.015em; color: var(--violeta);
  }
  .sub { margin: 7px 0 18px; font-size: 15px; line-height: 1.5; color: var(--gris); }

  /* Tarjetas de opción */
  .opciones { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .opcion {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    padding: 15px 16px; border: 1px solid var(--lila); border-radius: 14px;
    cursor: pointer; background: var(--blanco);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .opcion:hover {
    border-color: var(--violeta-medio); transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(45, 0, 93, 0.1);
  }
  .opcion input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .opcion:has(input:focus-visible) { outline: 3px solid var(--amarillo); outline-offset: 2px; }
  .opcion:has(input:checked) {
    border-color: var(--violeta); box-shadow: inset 0 0 0 1px var(--violeta);
  }
  .ico {
    display: grid; place-items: center; width: 40px; height: 40px;
    border-radius: 11px; background: var(--lila-claro); color: var(--violeta);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .opcion:hover .ico { background: var(--lila); }
  .opcion:has(input:checked) .ico { background: var(--violeta); color: var(--amarillo); }
  .txt { display: grid; gap: 3px; }
  .txt strong { font-size: 16px; color: var(--violeta); line-height: 1.3; }
  .txt small { font-size: 13.5px; color: var(--gris); line-height: 1.45; }
  .chev { color: var(--lila); flex: none; transition: color 0.15s ease, transform 0.15s ease; }
  .opcion:hover .chev { color: var(--fucsia); transform: translateX(2px); }

  /* Campos */
  .campo { display: grid; gap: 7px; margin: 0 0 18px; }
  label { font-weight: 700; font-size: 14.5px; color: var(--violeta); }

  input[type='text'], input[type='email'], input[type='tel'], input[type='url'], textarea {
    font: inherit; font-size: 16px; color: var(--texto);
    padding: 12px 14px; border: 1px solid var(--lila); border-radius: 11px;
    background: var(--blanco); width: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input::placeholder, textarea::placeholder { color: #9a92a6; }
  textarea { resize: vertical; min-height: 132px; line-height: 1.55; }
  input:hover, textarea:hover { border-color: var(--violeta-medio); }
  input:focus-visible, textarea:focus-visible {
    outline: 3px solid var(--amarillo); outline-offset: 1px;
    border-color: var(--violeta); box-shadow: 0 0 0 3px rgba(45, 0, 93, 0.06);
  }
  .ayuda { font-size: 13px; color: var(--gris); }
  .error { font-size: 13.5px; font-weight: 600; color: #b00020; }
  .error:empty { display: none; }
  [aria-invalid='true'] { border-color: #b00020; }

  /* Elegir WhatsApp o correo */
  .via { border: 0; padding: 0; margin: 0 0 18px; }
  .via legend { font-weight: 700; font-size: 14.5px; color: var(--violeta); padding: 0; margin-bottom: 9px; }
  .via-ops { display: flex; gap: 10px; flex-wrap: wrap; }
  .via-op {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 10px 17px; border: 1px solid var(--lila); border-radius: 999px;
    background: var(--blanco); cursor: pointer; font-weight: 700;
    font-size: 14.5px; color: var(--texto);
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .via-op input { accent-color: var(--fucsia); margin: 0; }
  .via-op:hover { border-color: var(--violeta-medio); }
  .via-op:has(input:checked) {
    border-color: var(--violeta); background: var(--violeta); color: var(--blanco);
  }
  .via-op:has(input:checked) input { accent-color: var(--amarillo); }
  .via-op:has(input:focus-visible) { outline: 3px solid var(--amarillo); outline-offset: 2px; }

  .nota-datos {
    display: flex; gap: 9px; align-items: flex-start;
    margin: 0 0 18px; padding: 11px 13px;
    background: var(--blanco); border: 1px solid var(--lila); border-radius: 11px;
    font-size: 13.5px; color: var(--gris); line-height: 1.5;
  }
  .nota-datos svg { flex: none; margin-top: 1px; color: var(--violeta-medio); }

  .avanza { margin: 2px 0 0; }
  .envio {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px;
    margin: 0; padding: 18px 0 0; border-top: 1px solid var(--lila);
  }
  .aviso { font-size: 14.5px; font-weight: 700; color: var(--violeta); }
  .aviso.mal { color: #b00020; }
  button[disabled] { opacity: 0.6; cursor: progress; }
  .boton { text-decoration: none; }

  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Final */
  .listo { padding: 34px var(--pad) 32px; text-align: center; }
  .tilde {
    width: 62px; height: 62px; margin: 0 auto 16px;
    display: grid; place-items: center; border-radius: 50%;
    background: var(--violeta); color: var(--amarillo);
    box-shadow: 0 0 0 7px rgba(255, 0, 255, 0.1);
  }
  .listo h3 {
    margin: 0 0 8px; font-family: var(--fuente-titulo);
    font-size: 23px; letter-spacing: -0.015em; color: var(--violeta);
  }
  .listo p { margin: 0 auto; max-width: 34ch; color: var(--texto); line-height: 1.6; }
  .mientras { margin-top: 14px !important; font-size: 15px; }
  .otra {
    font: inherit; font-weight: 700; color: var(--fucsia-oscuro); background: none; border: 0;
    padding: 0; cursor: pointer; text-decoration: underline;
    text-underline-offset: 2px;
  }
  .otra:hover { color: var(--violeta); }
  .otra:focus-visible { outline: 3px solid var(--amarillo); outline-offset: 2px; border-radius: 3px; }

  @media (max-width: 620px) {
    .asistente { --pad: 18px; border-radius: 15px; margin-top: 18px; }
    form { padding-top: 20px; padding-bottom: 22px; }
    .opcion { grid-template-columns: auto 1fr; padding: 14px; gap: 12px; }
    .chev { display: none; }
    .via-op { flex: 1 1 auto; justify-content: center; }
    .avanza .boton, .envio .boton { width: 100%; }
    .envio { gap: 10px; }
    .aviso { width: 100%; text-align: center; }
    .listo { padding-top: 30px; padding-bottom: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .opcion, .ico, .chev, .via-op, input, textarea { transition: none; }
    .opcion:hover { transform: none; }
    .opcion:hover .chev { transform: none; }
  }
</style>

<script is:inline>
  (() => {
    const caja = document.querySelector('[data-asistente]');
    if (!caja) return;
    const f = caja.querySelector('form');
    const pasos = [...caja.querySelectorAll('.paso')];
    const tramos = [...caja.querySelectorAll('.barra span')];
    const cabecera = caja.querySelector('[data-cabecera]');
    const contador = caja.querySelector('[data-contador]');
    const volver = caja.querySelector('[data-volver]');
    const listo = caja.querySelector('[data-listo]');
    const aviso = caja.querySelector('.aviso');
    const enviar = f.querySelector('button[type="submit"]');
    // En la página de publicidad el motivo ya viene dado y el asistente
    // arranca directamente en el segundo paso.
    const fijo = caja.dataset.fijo || '';
    const primero = fijo ? 2 : 1;

    // Textos del paso 2 según lo que eligieron en el paso 1
    const guion = {
      publicidad: ['Contanos de tu marca', '¿Qué vendés o qué servicio ofrecés?', 'Tu consulta'],
      otro: ['Contanos de qué se trata', '¿Algo que quieras decirnos?', 'Mensaje'],
    };

    let actual = primero;

    // En la primera pintada no se roba el foco: la página recién se abre.
    let arranque = true;

    const pintar = () => {
      pasos.forEach((p) => (p.hidden = Number(p.dataset.paso) !== actual));
      tramos.forEach((t) => t.toggleAttribute('data-activo', Number(t.dataset.tramo) <= actual));
      volver.hidden = actual === primero;
      contador.textContent = 'Paso ' + (actual - primero + 1) + ' de ' + pasos.length;
      const vivo = caja.querySelector('.paso[data-paso="' + actual + '"]');
      const foco = vivo && vivo.querySelector('input:not([type="radio"]), textarea');
      if (foco && actual > 1 && !arranque) foco.focus({ preventScroll: true });
      arranque = false;
      const y = caja.getBoundingClientRect().top + scrollY - 90;
      if (scrollY > y) scrollTo({ top: y, behavior: 'smooth' });
    };

    const elegido = () => fijo || (f.querySelector('[name="motivo"]:checked') || {}).value || 'otro';

    const aplicarGuion = () => {
      const [preg, sub, lab] = guion[elegido()] || guion.otro;
      caja.querySelector('[data-preg2]').textContent = preg;
      caja.querySelector('[data-sub2]').textContent = sub;
      caja.querySelector('[data-lab2]').textContent = lab;
      caja.querySelectorAll('[data-solo]').forEach((c) => (c.hidden = c.dataset.solo !== elegido()));
    };

    const via = () => (f.querySelector('[name="via"]:checked') || {}).value || 'whatsapp';

    const aplicarVia = () => {
      caja.querySelectorAll('[data-via]').forEach((c) => (c.hidden = c.dataset.via !== via()));
    };

    f.querySelectorAll('[name="via"]').forEach((r) => r.addEventListener('change', aplicarVia));

    // Elegir una opción avanza sola, como en un asistente
    f.querySelectorAll('[name="motivo"]').forEach((r) =>
      r.addEventListener('change', () => {
        aplicarGuion();
        actual = 2;
        pintar();
      })
    );

    caja.querySelector('[data-sigue]').addEventListener('click', () => {
      if (elegido() === 'publicidad') {
        const n = f.querySelector('[name="negocio"]');
        const en = caja.querySelector('#e-negocio');
        if (n.value.trim().length < 2) {
          en.textContent = 'Poné el nombre de tu negocio, aunque sea cómo lo conocen.';
          n.setAttribute('aria-invalid', 'true');
          n.focus();
          return;
        }
        en.textContent = '';
        n.removeAttribute('aria-invalid');
      }
      const t = f.querySelector('[name="mensaje"]');
      const e = caja.querySelector('#e-mensaje');
      if (t.value.trim().length < 10) {
        e.textContent = 'Contanos un poco más, con menos de diez caracteres no alcanza.';
        t.setAttribute('aria-invalid', 'true');
        t.focus();
        return;
      }
      e.textContent = '';
      t.removeAttribute('aria-invalid');
      actual = 3;
      pintar();
    });

    volver.addEventListener('click', () => {
      actual = Math.max(primero, actual - 1);
      pintar();
    });

    const limpiar = () => {
      caja.querySelectorAll('.error').forEach((e) => (e.textContent = ''));
      caja.querySelectorAll('[aria-invalid]').forEach((c) => c.removeAttribute('aria-invalid'));
    };

    caja.querySelector('[data-otra]')?.addEventListener('click', () => {
      f.reset();
      limpiar();
      aviso.textContent = '';
      aviso.classList.remove('mal');
      f.querySelectorAll('input[type="radio"][name="motivo"]').forEach((r) => (r.checked = false));
      f.querySelector('[name="abierto"]').value = String(Math.floor(Date.now() / 1000));
      listo.hidden = true;
      cabecera.hidden = false;
      f.hidden = false;
      actual = primero;
      aplicarGuion();
      aplicarVia();
      pintar();
    });

    f.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      limpiar();
      aviso.textContent = '';
      aviso.classList.remove('mal');
      enviar.disabled = true;
      try {
        const r = await fetch(f.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(f),
        });
        const d = await r.json();
        if (d.ok) {
          f.hidden = true;
          cabecera.hidden = true;
          listo.hidden = false;
          listo.querySelector('h3').focus?.();
        } else {
          let volvio = false;
          for (const [campo, texto] of Object.entries(d.errores || {})) {
            const e = caja.querySelector('#e-' + campo);
            const c = f.querySelector('[name="' + campo + '"]');
            if (e) e.textContent = texto;
            if (c) c.setAttribute('aria-invalid', 'true');
            if ((campo === 'mensaje' || campo === 'negocio') && !volvio) { actual = 2; pintar(); volvio = true; }
            if (campo === 'general') { aviso.textContent = texto; aviso.classList.add('mal'); }
          }
          const fallo = f.querySelector('[aria-invalid="true"]');
          if (fallo) fallo.focus();
        }
      } catch {
        aviso.textContent = 'No se pudo enviar. Probá de nuevo en un rato.';
        aviso.classList.add('mal');
      } finally {
        enviar.disabled = false;
      }
    });

    // Arranque: sin elegir nada todavía
    f.querySelectorAll('input[type="radio"][name="motivo"]').forEach((r) => (r.checked = false));
    f.querySelector('[name="abierto"]').value = String(Math.floor(Date.now() / 1000));
    aplicarGuion();
    aplicarVia();
    pintar();
  })();
</script>
