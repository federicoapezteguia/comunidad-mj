---
// Formulario de contacto por pasos. Sin JavaScript se ve como un
// formulario normal, con todos los campos a la vista y un solo botón.
import { SITE } from '../config';

const opciones = [
  {
    id: 'radio',
    titulo: 'Mandar un mensaje a la radio',
    texto: 'Un saludo, un pedido de tema o participar de la programación.',
    icono: 'M12 3a4 4 0 0 1 4 4v4a4 4 0 0 1-8 0V7a4 4 0 0 1 4-4zM5 11a7 7 0 0 0 14 0M12 18v3',
  },
  {
    id: 'publicidad',
    titulo: 'Publicitar mi negocio',
    texto: 'Spots en la FM, banners en el sitio y notas de contenido de marca.',
    icono: 'M3 10v4h4l5 4V6l-5 4H3zM16 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12',
  },
  {
    id: 'correccion',
    titulo: 'Corregir algo de una nota',
    texto: 'Un dato equivocado, un nombre mal escrito o una aclaración.',
    icono: 'M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4zM14 6l4 4',
  },
  {
    id: 'otro',
    titulo: 'Otra consulta',
    texto: 'Cualquier otra cosa que nos quieras escribir.',
    icono: 'M21 12a9 9 0 0 1-13 8l-5 1 1-5a9 9 0 1 1 17-4z',
  },
];
---

<div class="asistente" data-asistente>
  <div class="barra" aria-hidden="true">
    <span data-tramo="1"></span><span data-tramo="2"></span><span data-tramo="3"></span>
  </div>

  <form method="post" action="/api/contacto.php" novalidate>
    <button type="button" class="volver" data-volver hidden>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      Volver
    </button>

    <!-- Paso 1 -->
    <fieldset class="paso" data-paso="1">
      <legend class="preg">¿Qué necesitás?</legend>
      <p class="sub">Elegí lo que más se parezca a tu caso.</p>
      <ul class="opciones">
        {opciones.map((o, i) => (
          <li>
            <label class="opcion">
              <input type="radio" name="motivo" value={o.id} required checked={i === 0} />
              <span class="ico" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={o.icono} /></svg>
              </span>
              <span class="txt">
                <strong>{o.titulo}</strong>
                <small>{o.texto}</small>
              </span>
              <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </label>
          </li>
        ))}
      </ul>
    </fieldset>

    <!-- Paso 2 -->
    <fieldset class="paso" data-paso="2">
      <legend class="preg" data-preg2>Contanos de qué se trata</legend>
      <p class="sub" data-sub2>Escribilo con tus palabras, no hace falta que sea formal.</p>

      <p class="campo" data-solo="correccion" hidden>
        <label for="c-enlace">Enlace de la nota</label>
        <input id="c-enlace" name="enlace" type="url" maxlength="300" placeholder="https://www.comunidadfanmj.com.ar/..." />
        <small class="ayuda">Copiá la dirección desde la barra del navegador.</small>
      </p>

      <p class="campo">
        <label for="c-mensaje" data-lab2>Mensaje</label>
        <textarea id="c-mensaje" name="mensaje" rows="6" maxlength="4000" required></textarea>
        <span class="error" id="e-mensaje" aria-live="polite"></span>
      </p>

      <p class="avanza"><button type="button" class="boton boton-violeta" data-sigue>Continuar</button></p>
    </fieldset>

    <!-- Paso 3 -->
    <fieldset class="paso" data-paso="3">
      <legend class="preg">¿A dónde te respondemos?</legend>
      <p class="sub">Te contestamos al correo. Si dejás tu WhatsApp, puede que te escribamos por ahí.</p>

      <div class="dos-campos">
        <p class="campo">
          <label for="c-nombre">Tu nombre</label>
          <input id="c-nombre" name="nombre" type="text" maxlength="80" required autocomplete="name" placeholder="Nombre y apellido" />
          <span class="error" id="e-nombre" aria-live="polite"></span>
        </p>
        <p class="campo">
          <label for="c-email">Correo</label>
          <input id="c-email" name="email" type="email" maxlength="120" required autocomplete="email" placeholder="tucorreo@ejemplo.com" />
          <span class="error" id="e-email" aria-live="polite"></span>
        </p>
      </div>

      <p class="campo">
        <label for="c-wa">WhatsApp <span class="opt">(opcional)</span></label>
        <input id="c-wa" name="whatsapp" type="tel" maxlength="30" autocomplete="tel" placeholder="3472 123456" />
      </p>

      <p class="nota-datos">Usamos tus datos solo para responderte. No se los damos a nadie ni te sumamos a ninguna lista.</p>

      <p class="envio">
        <button type="submit" class="boton boton-violeta">Enviar mensaje</button>
        <span class="aviso" role="status"></span>
      </p>
    </fieldset>

    <p class="trampa" aria-hidden="true">
      <label for="c-sitio">No completar</label>
      <input id="c-sitio" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
    </p>
    <input type="hidden" name="abierto" value="" />
  </form>

  <div class="listo" data-listo hidden>
    <div class="tilde" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.5 5.5L20 7" /></svg>
    </div>
    <h3>Mensaje enviado</h3>
    <p>Gracias por escribirnos. Te respondemos al correo que dejaste.</p>
    <p class="mientras">Mientras tanto, <a href={SITE.redes.instagram} target="_blank" rel="noopener">seguinos en Instagram</a> o <a href="/en-vivo/">escuchá la radio en vivo</a>.</p>
  </div>
</div>

<style>
  /* Un display propio pisa el atributo hidden, así que se fuerza acá */
  [hidden] { display: none !important; }

  .asistente {
    border: 1px solid var(--borde);
    border-radius: 18px;
    background: var(--blanco);
    padding: 0 0 26px;
    margin: 20px 0 8px;
    box-shadow: 0 10px 30px rgba(45, 0, 93, 0.06);
  }

  /* Barra de progreso */
  .barra { display: flex; gap: 6px; padding: 18px 26px 0; }
  .barra span {
    flex: 1; height: 4px; border-radius: 500px; background: var(--lila);
    transition: background 0.25s ease;
  }
  .barra span[data-activo] { background: var(--fucsia); }

  form { padding: 0 26px; margin: 0; }

  .volver {
    display: inline-flex; align-items: center; gap: 5px;
    margin: 16px 0 0; padding: 4px 0;
    background: none; border: 0; cursor: pointer;
    font: inherit; font-size: 14px; font-weight: 700; color: var(--violeta-medio);
  }
  .volver:hover { color: var(--fucsia-oscuro); }

  .paso { border: 0; margin: 0; padding: 18px 0 0; min-inline-size: 0; }
  .preg {
    padding: 0; margin: 0;
    font-family: var(--fuente-titulo);
    font-size: clamp(21px, 3.2vw, 27px); font-weight: 700; line-height: 1.2;
    letter-spacing: -0.015em; color: var(--violeta);
  }
  .sub { margin: 6px 0 18px; font-size: 15px; color: var(--gris); }

  /* Tarjetas de opción */
  .opciones { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .opcion {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    padding: 14px 16px; border: 1px solid var(--borde); border-radius: 13px;
    cursor: pointer; background: var(--blanco);
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .opcion:hover { border-color: var(--lila); background: var(--lila-claro); transform: translateY(-1px); }
  .opcion input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .opcion:has(input:focus-visible) { outline: 3px solid var(--amarillo); outline-offset: 2px; }
  .opcion:has(input:checked) { border-color: var(--violeta); background: var(--lila-claro); }
  .ico {
    display: grid; place-items: center; width: 38px; height: 38px;
    border-radius: 10px; background: var(--lila-claro); color: var(--violeta);
  }
  .opcion:has(input:checked) .ico { background: var(--violeta); color: #fff; }
  .txt { display: grid; gap: 2px; }
  .txt strong { font-size: 15.5px; color: var(--violeta); line-height: 1.3; }
  .txt small { font-size: 13.5px; color: var(--gris); line-height: 1.45; }
  .chev { color: var(--lila); flex: none; }
  .opcion:hover .chev { color: var(--violeta-medio); }

  /* Campos */
  .campo { display: grid; gap: 6px; margin: 0 0 16px; }
  .dos-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  label { font-weight: 700; font-size: 14.5px; color: var(--violeta); }
  .opt { font-weight: 600; color: var(--gris); }
  input[type='text'], input[type='email'], input[type='tel'], input[type='url'], textarea {
    font: inherit; font-size: 16px; color: var(--texto);
    padding: 11px 13px; border: 1px solid var(--borde); border-radius: 10px;
    background: var(--blanco); width: 100%;
  }
  textarea { resize: vertical; min-height: 130px; }
  input:focus-visible, textarea:focus-visible {
    outline: 3px solid var(--amarillo); outline-offset: 1px; border-color: var(--violeta);
  }
  .ayuda { font-size: 13px; color: var(--gris); }
  .error { font-size: 13.5px; color: #b00020; }
  .error:empty { display: none; }
  [aria-invalid='true'] { border-color: #b00020; }

  .nota-datos { margin: 2px 0 18px; font-size: 13.5px; color: var(--gris); line-height: 1.5; }
  .avanza, .envio { margin: 4px 0 0; }
  .envio { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .aviso { font-size: 14.5px; font-weight: 700; color: var(--violeta); }
  .aviso.mal { color: #b00020; }
  button[disabled] { opacity: 0.6; cursor: progress; }
  .boton { text-decoration: none; }

  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Final */
  .listo { padding: 30px 26px 10px; text-align: center; }
  .tilde {
    width: 58px; height: 58px; margin: 0 auto 14px;
    display: grid; place-items: center; border-radius: 50%;
    background: var(--lila-claro); color: var(--violeta);
  }
  .listo h3 { margin: 0 0 6px; font-size: 22px; color: var(--violeta); }
  .listo p { margin: 0 auto; max-width: 34ch; color: var(--texto); line-height: 1.6; }
  .mientras { margin-top: 12px !important; font-size: 15px; }

  @media (max-width: 560px) {
    .asistente { border-radius: 14px; }
    .barra, form, .listo { padding-left: 16px; padding-right: 16px; }
    .dos-campos { grid-template-columns: 1fr; }
    .opcion { grid-template-columns: auto 1fr; padding: 13px 14px; }
    .chev { display: none; }
    .avanza .boton, .envio .boton { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .opcion { transition: none; }
    .opcion:hover { transform: none; }
  }
</style>

<script is:inline>
  (() => {
    const caja = document.querySelector('[data-asistente]');
    if (!caja) return;
    const f = caja.querySelector('form');
    const pasos = [...caja.querySelectorAll('.paso')];
    const tramos = [...caja.querySelectorAll('.barra span')];
    const volver = caja.querySelector('[data-volver]');
    const listo = caja.querySelector('[data-listo]');
    const aviso = caja.querySelector('.aviso');
    const enviar = f.querySelector('button[type="submit"]');

    // Textos del paso 2 según lo que eligieron en el paso 1
    const guion = {
      radio: ['Contanos qué querés mandar', 'Un saludo, un pedido de tema o lo que quieras que salga al aire.', 'Tu mensaje'],
      publicidad: ['Contanos de tu negocio', 'Qué vendés y a quién le hablás. Con eso armamos la propuesta.', 'Tu consulta'],
      correccion: ['¿Qué hay que corregir?', 'Indicanos la nota y qué dato está mal.', 'El error que encontraste'],
      otro: ['Contanos de qué se trata', 'Escribilo con tus palabras, no hace falta que sea formal.', 'Mensaje'],
    };

    let actual = 1;

    const pintar = () => {
      pasos.forEach((p) => (p.hidden = Number(p.dataset.paso) !== actual));
      tramos.forEach((t) => t.toggleAttribute('data-activo', Number(t.dataset.tramo) <= actual));
      volver.hidden = actual === 1;
      const foco = pasos[actual - 1].querySelector('input:not([type="radio"]), textarea');
      if (foco && actual > 1) foco.focus({ preventScroll: true });
      const y = caja.getBoundingClientRect().top + scrollY - 90;
      if (scrollY > y) scrollTo({ top: y, behavior: 'smooth' });
    };

    const elegido = () => (f.querySelector('[name="motivo"]:checked') || {}).value || 'otro';

    const aplicarGuion = () => {
      const [preg, sub, lab] = guion[elegido()] || guion.otro;
      caja.querySelector('[data-preg2]').textContent = preg;
      caja.querySelector('[data-sub2]').textContent = sub;
      caja.querySelector('[data-lab2]').textContent = lab;
      caja.querySelectorAll('[data-solo]').forEach((c) => (c.hidden = c.dataset.solo !== elegido()));
    };

    // Elegir una opción avanza sola, como en un asistente
    f.querySelectorAll('[name="motivo"]').forEach((r) =>
      r.addEventListener('change', () => {
        aplicarGuion();
        actual = 2;
        pintar();
      })
    );

    caja.querySelector('[data-sigue]').addEventListener('click', () => {
      const t = f.querySelector('[name="mensaje"]');
      const e = caja.querySelector('#e-mensaje');
      if (t.value.trim().length < 10) {
        e.textContent = 'Contanos un poco más, con diez caracteres no alcanza.';
        t.setAttribute('aria-invalid', 'true');
        t.focus();
        return;
      }
      e.textContent = '';
      t.removeAttribute('aria-invalid');
      actual = 3;
      pintar();
    });

    volver.addEventListener('click', () => {
      actual = Math.max(1, actual - 1);
      pintar();
    });

    const limpiar = () => {
      caja.querySelectorAll('.error').forEach((e) => (e.textContent = ''));
      caja.querySelectorAll('[aria-invalid]').forEach((c) => c.removeAttribute('aria-invalid'));
    };

    f.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      limpiar();
      aviso.textContent = '';
      aviso.classList.remove('mal');
      enviar.disabled = true;
      try {
        const r = await fetch(f.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(f),
        });
        const d = await r.json();
        if (d.ok) {
          f.hidden = true;
          caja.querySelector('.barra').hidden = true;
          listo.hidden = false;
          listo.querySelector('h3').focus?.();
        } else {
          let volvio = false;
          for (const [campo, texto] of Object.entries(d.errores || {})) {
            const e = caja.querySelector('#e-' + campo);
            const c = f.querySelector('[name="' + campo + '"]');
            if (e) e.textContent = texto;
            if (c) c.setAttribute('aria-invalid', 'true');
            if (campo === 'mensaje' && !volvio) { actual = 2; pintar(); volvio = true; }
            if (campo === 'general') { aviso.textContent = texto; aviso.classList.add('mal'); }
          }
          const primero = f.querySelector('[aria-invalid="true"]');
          if (primero) primero.focus();
        }
      } catch {
        aviso.textContent = 'No se pudo enviar. Probá de nuevo o escribinos por WhatsApp.';
        aviso.classList.add('mal');
      } finally {
        enviar.disabled = false;
      }
    });

    // Arranque: sin elegir nada todavía
    f.querySelectorAll('[name="motivo"]').forEach((r) => (r.checked = false));
    f.querySelector('[name="abierto"]').value = String(Math.floor(Date.now() / 1000));
    aplicarGuion();
    pintar();
  })();
</script>
