---
import { SITE } from '../config';
---
<div class="barra" role="region" aria-label="Radio en vivo" transition:persist="radio">
  <audio id="radio-audio" preload="none" data-stream={SITE.stream} data-externo={SITE.reproductor}></audio>
  <div class="wrap fila">
    <button type="button" class="play" data-radio-toggle aria-label="Escuchar o pausar la radio en vivo">
      <svg class="ic-play" width="18" height="18" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1l8 5-8 5z" fill="currentColor"></path></svg>
      <svg class="ic-pausa" width="18" height="18" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1h2.5v10H2.5zM7 1h2.5v10H7z" fill="currentColor"></path></svg>
      <span class="ic-carga" aria-hidden="true"></span>
    </button>
    <div class="texto">
      <span class="vivo"><span class="punto" aria-hidden="true"></span>En vivo · FM {SITE.frecuencia}</span>
      <span class="nombre">
        <span class="txt-play">Escuchá Comunidad FAN Marcos Juárez</span>
        <span class="txt-carga">Conectando con la radio…</span>
        <span class="txt-pausa">Estás escuchando Comunidad FAN Marcos Juárez</span>
      </span>
    </div>
    <label class="volumen">
      <span class="sr-only">Volumen</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"></path><path d="M16.5 8.5a5 5 0 0 1 0 7"></path></svg>
      <input type="range" min="0" max="1" step="0.05" value="0.9" data-radio-volumen />
    </label>
    <a href={SITE.youtubeVivo} target="_blank" rel="noopener" class="mirar" aria-label="Mirá el stream en YouTube">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"></rect><path d="M10 9l5 3-5 3z" fill="currentColor"></path></svg>
      <span class="mirar-txt">Mirar en YouTube</span>
    </a>
  </div>
</div>

<script>
  // Reproductor de la radio dentro del sitio. La barra se conserva al cambiar
  // de página (navegación sin recarga), así la radio no se corta.
  const audio = document.getElementById('radio-audio') as HTMLAudioElement;
  const stream = audio.dataset.stream!;
  const externo = audio.dataset.externo!;
  let estado: 'parado' | 'cargando' | 'sonando' = 'parado';

  const marcar = (e: typeof estado) => {
    estado = e;
    document.documentElement.dataset.radio = e;
    document.querySelectorAll('[data-radio-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(e !== 'parado')));
  };

  async function reproducir() {
    marcar('cargando');
    audio.src = stream; // siempre la señal en vivo, sin demora acumulada
    try {
      await audio.play();
    } catch {
      marcar('parado');
      window.open(externo, '_blank', 'noopener');
    }
  }
  function pausar() {
    audio.pause();
    audio.removeAttribute('src');
    audio.load();
    marcar('parado');
  }

  audio.addEventListener('playing', () => marcar('sonando'));
  audio.addEventListener('waiting', () => estado === 'sonando' && marcar('cargando'));
  audio.addEventListener('error', () => {
    if (estado !== 'parado') {
      marcar('parado');
      window.open(externo, '_blank', 'noopener');
    }
  });

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-radio-toggle]');
    if (!t) return;
    e.preventDefault();
    estado === 'parado' ? reproducir() : pausar();
  });

  const vol = document.querySelector<HTMLInputElement>('[data-radio-volumen]');
  try {
    const v = localStorage.getItem('radio-volumen');
    if (v && vol) vol.value = v;
  } catch {}
  if (vol) {
    audio.volume = Number(vol.value);
    vol.addEventListener('input', () => {
      audio.volume = Number(vol.value);
      try { localStorage.setItem('radio-volumen', vol.value); } catch {}
    });
  }

  if ('mediaSession' in navigator) {
    navigator.mediaSession.metadata = new MediaMetadata({
      title: 'Comunidad FAN Marcos Juárez',
      artist: 'FM 99.9 · En vivo',
      artwork: [{ src: '/img/fm-99-9-marcos-juarez-comunidad-fan.png', sizes: '498x555', type: 'image/png' }],
    });
    navigator.mediaSession.setActionHandler('play', () => reproducir());
    navigator.mediaSession.setActionHandler('pause', () => pausar());
    navigator.mediaSession.setActionHandler('stop', () => pausar());
  }

  // Al cambiar de página se renueva el <html>: volver a marcar el estado.
  document.addEventListener('astro:after-swap', () => marcar(estado));
  marcar('parado');
</script>

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--violeta-noche);
    padding: 8px 0;
    box-shadow: 0 -4px 16px rgba(30, 0, 64, 0.25);
  }
  .fila { display: flex; align-items: center; gap: 14px; }
  .play {
    display: inline-flex; align-items: center; justify-content: center; position: relative;
    width: 48px; height: 48px; flex: none; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--fucsia); color: var(--violeta-noche);
  }
  .play:hover { transform: scale(1.05); }
  .texto { display: flex; flex-direction: column; min-width: 0; }
  .vivo {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 800; color: var(--amarillo);
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--amarillo); animation: latido 1.6s infinite; }
  .nombre { font-size: 15px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .volumen { margin-left: auto; display: none; align-items: center; gap: 8px; color: #fff; }
  .volumen input { width: 110px; accent-color: var(--fucsia); }
  .mirar {
    flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; min-width: 44px; padding: 0 16px; border-radius: 500px; margin-left: auto;
    background: rgba(255, 255, 255, 0.12); color: #fff; font-weight: 800; font-size: 14px;
  }
  .volumen + .mirar { margin-left: 0; }
  .mirar:hover { background: rgba(255, 255, 255, 0.22); color: #fff; }
  @media (min-width: 800px) { .volumen { display: inline-flex; } }
  @media (max-width: 560px) { .mirar { padding: 0; width: 44px; } .mirar-txt { display: none; } }
  @keyframes latido { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) { .punto { animation: none; } }
</style>
