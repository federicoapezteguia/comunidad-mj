---
import { SITE } from '../config';
---
<div class="barra" role="region" aria-label="Radio en vivo">
  <div class="wrap fila">
    <a href={SITE.reproductor} target="_blank" rel="noopener" class="play" data-abrir-radio aria-label="Escuchar Comunidad FAN Marcos Juárez en vivo (abre el reproductor)">
      <svg width="18" height="18" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1l8 5-8 5z" fill="currentColor"></path></svg>
    </a>
    <div class="texto">
      <span class="vivo"><span class="punto" aria-hidden="true"></span>En vivo · FM {SITE.frecuencia}</span>
      <span class="nombre">Escuchá Comunidad FAN Marcos Juárez</span>
    </div>
    <a href={SITE.youtubeVivo} target="_blank" rel="noopener" class="mirar" aria-label="Mirá el stream en YouTube">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"></rect><path d="M10 9l5 3-5 3z" fill="currentColor"></path></svg>
      <span class="saludo-txt">Mirar</span>
    </a>
    <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hola Comunidad FAN Marcos Juárez! ')}`} target="_blank" rel="noopener" class="saludo" aria-label="Mandá tu saludo a la radio por WhatsApp">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.5-4A8 8 0 1 1 8 18.5z"></path></svg>
      <span class="saludo-txt">Mandá tu saludo</span>
    </a>
  </div>
</div>

<script>
  // En computadora abre el reproductor en una ventana chica para que la
  // radio siga sonando mientras se navega el sitio. En el celular (o si el
  // navegador bloquea la ventana) el enlace lo abre en una pestaña nueva.
  document.querySelectorAll<HTMLAnchorElement>('[data-abrir-radio]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (window.matchMedia('(max-width: 720px)').matches) return;
      const w = window.open(a.href, 'radio-fan', 'width=480,height=760');
      if (w) {
        e.preventDefault();
        w.focus();
      }
    });
  });
</script>

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--violeta-noche);
    padding: 8px 0;
    box-shadow: 0 -4px 16px rgba(30, 0, 64, 0.25);
  }
  .fila { display: flex; align-items: center; gap: 14px; }
  .saludo {
    margin-left: auto; flex: none; display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; min-width: 44px; justify-content: center; padding: 0 16px; border-radius: 500px;
    background: #1f7a3a; color: #fff; font-weight: 800; font-size: 14px;
  }
  .saludo:hover { background: #18652f; color: #fff; }
  .mirar {
    margin-left: auto; flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; min-width: 44px; padding: 0 16px; border-radius: 500px;
    background: rgba(255, 255, 255, 0.12); color: #fff; font-weight: 800; font-size: 14px;
  }
  .mirar:hover { background: rgba(255, 255, 255, 0.22); color: #fff; }
  .mirar + .saludo { margin-left: 0; }
  @media (max-width: 560px) { .saludo, .mirar { padding: 0; width: 44px; } .saludo-txt { display: none; } }
  .play {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; flex: none; border-radius: 50%;
    background: var(--fucsia); color: var(--violeta-noche);
  }
  .play:hover { color: var(--violeta-noche); transform: scale(1.05); }
  .texto { display: flex; flex-direction: column; min-width: 0; }
  .vivo {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 800; color: var(--amarillo);
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--amarillo); animation: latido 1.6s infinite; }
  .nombre { font-size: 15px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @keyframes latido { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) { .punto { animation: none; } }
</style>
