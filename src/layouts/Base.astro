---
import '../styles/global.css';
import '../styles/animaciones.css';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraEnVivo from '../components/BarraEnVivo.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { SITE } from '../config';
import fallbackOg from '../assets/og-default.png';

interface Props {
  titulo: string;
  descripcion?: string;
  imagen?: ImageMetadata;
  imagenAlt?: string;
  tipo?: 'website' | 'article';
  articulo?: { publicado: Date; modificado?: Date; seccion: string; etiquetas: string[]; autor: string };
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  anterior?: string;
  siguiente?: string;
  sinMarco?: boolean;
}

const {
  titulo,
  descripcion = SITE.descripcion,
  imagen,
  imagenAlt,
  tipo = 'website',
  articulo,
  jsonLd = [],
  noindex = false,
  anterior,
  siguiente,
  sinMarco = false,
} = Astro.props;

const staging = __STAGING__;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const conMarca = `${titulo} | ${SITE.nombre}`;
// Google corta los títulos de más de ~65 caracteres: si no entra la marca, va solo el título.
const tituloCompleto = Astro.url.pathname === '/' || conMarca.length > 65 ? titulo : conMarca;
const descMeta = descripcion.length > 160 ? descripcion.slice(0, 157).replace(/\s+\S*$/, '') + '…' : descripcion;

const og = await getImage({ src: imagen ?? fallbackOg, width: 1200, height: 675, format: 'jpg', quality: 82, fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site).href;

const robots = staging || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const organizacion = {
  '@context': 'https://schema.org',
  '@type': ['NewsMediaOrganization', 'RadioStation'],
  '@id': new URL('/#organizacion', Astro.site).href,
  name: SITE.nombre,
  url: new URL('/', Astro.site).href,
  logo: { '@type': 'ImageObject', url: new URL(SITE.logoSenal.src, Astro.site).href, width: SITE.logoSenal.w, height: SITE.logoSenal.h, caption: SITE.logoSenal.titulo },
  image: new URL(SITE.logoSenal.src, Astro.site).href,
  broadcastFrequency: `FM ${SITE.frecuencia}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.direccion,
    addressLocality: SITE.ciudad,
    addressRegion: SITE.provincia,
    postalCode: SITE.codigoPostal,
    addressCountry: SITE.pais,
  },
  areaServed: [SITE.ciudad, 'Sudeste de Córdoba', 'Provincia de Córdoba'],
  parentOrganization: { '@type': 'Organization', name: 'Comunidad FAN', url: SITE.red },
  sameAs: Object.values(SITE.redes).filter(Boolean),
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descMeta} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {anterior && <link rel="prev" href={new URL(anterior, Astro.site).href} />}
    {siguiente && <link rel="next" href={new URL(siguiente, Astro.site).href} />}
    <meta name="theme-color" content="#ff00ff" />
    <ClientRouter fallback="swap" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="alternate" type="application/rss+xml" title={SITE.nombre} href="/rss.xml" />

    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    {imagenAlt && <meta property="og:image:alt" content={imagenAlt} />}
    {articulo && (
      <>
        <meta property="article:published_time" content={articulo.publicado.toISOString()} />
        <meta property="article:modified_time" content={(articulo.modificado ?? articulo.publicado).toISOString()} />
        <meta property="article:section" content={articulo.seccion} />
        {articulo.etiquetas.map((e) => <meta property="article:tag" content={e} />)}
        <meta name="author" content={articulo.autor} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    {!sinMarco && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!sinMarco && <Footer />}
    {!sinMarco && <BarraEnVivo />}
    {!sinMarco && <WhatsAppFlotante />}
    <script>
      // Animaciones: aparición al hacer scroll, fotos que entran suave y barra de lectura.
      const OBJETIVOS = [
        '.sec-h', '.grid-notas > *', '.lista-comp > *', '.d-lado > *', '.pub', '.clima', '.ultimas li',
        '.ranking li', '.intro-seccion', '.nota .texto > *', '.foto-principal', '.compartir', '.etiquetas',
        '.footer .wrap > *', '.listado > *', '.paginacion', '.pagina-simple > *',
      ].join(',');
      let observador: IntersectionObserver | null = null;
      let alScroll: (() => void) | null = null;

      function animar() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        observador?.disconnect();
        observador = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                observador?.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll<HTMLElement>(OBJETIVOS).forEach((el) => {
          if (el.closest('.pegajoso') || el.classList.contains('rev')) return;
          const hermanos = el.parentElement ? Array.from(el.parentElement.children) : [];
          el.style.setProperty('--i', String(Math.min(hermanos.indexOf(el), 5)));
          el.classList.add('rev');
          observador!.observe(el);
        });

        // Fotos: se desvanecen al entrar cuando terminan de cargar
        document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => {
          if (img.complete) return;
          img.classList.add('cargando');
          img.addEventListener('load', () => { img.classList.remove('cargando'); img.classList.add('cargada'); }, { once: true });
          img.addEventListener('error', () => img.classList.remove('cargando'), { once: true });
        });

        // Barra de lectura en las notas
        document.querySelector('.barra-lectura')?.remove();
        if (alScroll) removeEventListener('scroll', alScroll);
        const texto = document.querySelector<HTMLElement>('.nota');
        if (texto) {
          const barra = document.createElement('div');
          barra.className = 'barra-lectura';
          barra.setAttribute('aria-hidden', 'true');
          document.body.appendChild(barra);
          alScroll = () => {
            const r = texto.getBoundingClientRect();
            const total = r.height - innerHeight * 0.6;
            const avance = Math.min(1, Math.max(0, -r.top / (total > 0 ? total : 1)));
            barra.style.setProperty('--avance', avance.toFixed(3));
          };
          addEventListener('scroll', alScroll, { passive: true });
          alScroll();
        }
      }
      document.addEventListener('astro:page-load', animar);
    </script>
  </body>
</html>
