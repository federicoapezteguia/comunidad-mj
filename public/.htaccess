# ============================================================
# Seguridad del servidor (Apache / LiteSpeed)
# ============================================================

# Sin listado de carpetas
Options -Indexes

# Forzar HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Dominio definitivo: siempre con www
  RewriteCond %{HTTP_HOST} ^comunidadfanmj\.com\.ar$ [NC]
  RewriteRule ^ https://www.comunidadfanmj.com.ar%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Bloquear archivos ocultos (.git, .env, estado del deploy, etc.) salvo .well-known
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

# Encuestas: los archivos internos de PHP no se sirven directo
<FilesMatch "^(_encuestas|config)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# ============================================================
# Página de error propia
# ============================================================
ErrorDocument 404 /404.html

# ============================================================
# Compresión (páginas y textos viajan mucho más livianos)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/rss+xml
</IfModule>

# ============================================================
# Caché del navegador
# Las fotos y el CSS/JS llevan un código único en el nombre:
# si cambian, cambia el nombre, así que se pueden guardar un año.
# El HTML no se guarda, para que las notas nuevas aparezcan enseguida.
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|css|js|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
